}

install_cloudflared() {
  info "Installing cloudflared binary for zero-config quick tunnels..."
  local arch
  arch=$(uname -m)
  local cf_arch="amd64"
  case "$arch" in
    x86_64) cf_arch="amd64" ;;
    aarch64|arm64) cf_arch="arm64" ;;
    armv7l|armhf) cf_arch="arm" ;;
    i386|i686) cf_arch="386" ;;
  esac

  local dl_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}"
  local target_bin="/usr/local/bin/cloudflared"

  if curl -fsSL "$dl_url" -o "$target_bin" 2>/dev/null; then
    chmod +x "$target_bin"
    success "cloudflared installed to $target_bin"
    return 0
  fi

  # Fallback to local fire bin directory
  mkdir -p /tmp/fire-bin
  if curl -fsSL "$dl_url" -o "/tmp/fire-bin/cloudflared" 2>/dev/null; then
    chmod +x "/tmp/fire-bin/cloudflared"
    export PATH="/tmp/fire-bin:$PATH"
    success "cloudflared installed to /tmp/fire-bin/cloudflared"
    return 0
  fi

  return 1
}

open_quick_tunnel() {
  local port="$1"
  local start_ts="$2"

  info "Starting zero-config Cloudflare Quick Tunnel for localhost:$port..."

  # Ensure cloudflared is installed
  if ! command -v cloudflared &>/dev/null; then
    if ! install_cloudflared; then
      error "Could not install cloudflared. Install it from https://github.com/cloudflare/cloudflared/releases"
      exit 1
    fi
  fi

  local log_file
  log_file="$(tunnel_log_file "$port")"
  ensure_tunnel_dir
  > "$log_file"

  # Kill any previous background process on this port
  if read_tunnel_state "$port"; then
    if [[ "$TUNNEL_STATE_PID" =~ ^[0-9]+$ && "$TUNNEL_STATE_PID" -gt 0 ]]; then
      kill "$TUNNEL_STATE_PID" 2>/dev/null || true
    fi
  fi

  # Run cloudflared in background
  nohup cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$port" > "$log_file" 2>&1 &
  local tunnel_pid=$!

  # Wait for public URL to appear in log (up to 20 seconds)
  local url=""
  for ((i=0; i<40; i++)); do
    if [[ -f "$log_file" ]]; then
      url=$(grep -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' "$log_file" | head -n 1)
      if [[ -n "$url" ]]; then
        break
      fi
    fi
    if ! kill -0 "$tunnel_pid" 2>/dev/null; then
      break
    fi
    sleep 0.5
  done

  if [[ -z "$url" ]]; then
    kill "$tunnel_pid" 2>/dev/null || true
    error "Failed to establish Cloudflare Quick Tunnel. Log output:"
    cat "$log_file" 2>/dev/null | tail -n 10
    exit 1
  fi

  # Save state
  write_tunnel_state "$port" "$tunnel_pid" "$url" "$log_file" "$start_ts" "quick"

  success "Quick Tunnel established for ${CYAN}localhost:$port${NC}"
  echo -e "  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}URL:${NC} ${CYAN}${BOLD}$url${NC}"
  echo -e "  ${GREY}⚡${NC} ${GREY}${BOLD}Provider:${NC} ${GREY}Cloudflare Quick Tunnel${NC}  ${GREY}🚫${NC} ${GREY}${BOLD}Close:${NC} ${GREY}fire tunnel close $port${NC}"
  echo "$url"
}

open_custom_tunnel() {
  local port="$1"
  local start_ts="$2"

  if [[ -z "$TUNNEL_BASE_DOMAIN" ]]; then
    warn "No custom domain configured. Run 'fire tunnel setup' first or use '--provider quick'."
    open_quick_tunnel "$port" "$start_ts"
    return
  fi

  if ! command -v nginx &>/dev/null; then
    error "Nginx is not installed. Run 'fire tunnel setup' or use '--provider quick' for zero-config tunnels."
    exit 1
  fi

  # Generate 8-char hex hash
  local hash
  hash=$(openssl rand -hex 4 2>/dev/null || cat /proc/sys/kernel/random/uuid | tr -d '-' | head -c 8)
  local map_key
  map_key=$(tunnel_map_key_for_hash "$hash")
  local url
  url=$(generate_tunnel_url "$hash")

  # Register in nginx map and reload
  if ! nginx_map_add "$map_key" "$port"; then
    error "Could not update nginx tunnel map or reload nginx. Ensure Nginx is running."
    exit 1
  fi

  # Persist state (PID=0, managed by Nginx)
  write_tunnel_state "$port" "0" "$url" "" "$start_ts" "custom"

  success "Custom Tunnel established for ${CYAN}localhost:$port${NC}"
  echo -e "  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}URL:${NC} ${CYAN}${BOLD}$url${NC}"
  echo -e "  ${GREY}🔑${NC} ${GREY}${BOLD}Hash:${NC} ${GREY}$hash${NC}  ${GREY}⚡${NC} ${GREY}${BOLD}Provider:${NC} ${GREY}Custom Nginx ($TUNNEL_BASE_DOMAIN)${NC}  ${GREY}🚫${NC} ${GREY}${BOLD}Close:${NC} ${GREY}fire tunnel close $port${NC}"
  echo "$url"
}

action_tunnel_setup() {
  echo -e "${CYAN}${BOLD}Fire Tunnel Setup — Custom Domain Configuration${NC}"
  echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
  echo -e "Configure your own domain for wildcard reverse-proxy tunnels."
  echo -e "${GREY}Requirements: Wildcard DNS (*.yourdomain.com -> Server IP) and SSL certificate.${NC}"
  echo ""

  read -r -p "Enter your base domain (e.g. mydomain.com or tunnel.mydomain.com): " input_domain
  [[ -z "$input_domain" ]] && error "Domain cannot be empty." && exit 1

  read -r -p "Enter SSL Certificate path (fullchain.pem) [leave blank to configure later]: " input_cert
  read -r -p "Enter SSL Private Key path (privkey.pem) [leave blank to configure later]: " input_key

  mkdir -p /etc/fire-pm /etc/nginx
  local config_file="/etc/fire-pm/config.json"

  python3 -c "
import json, os
path = '$config_file'
data = {}
if os.path.exists(path):
  try:
    with open(path, 'r') as f: data = json.load(f)
  except: pass
data['tunnel'] = {
  'provider': 'custom',
  'domain': '$input_domain',
  'sslCert': '$input_cert',
  'sslKey': '$input_key'
}
with open(path, 'w') as f:
  json.dump(data, f, indent=2)
" 2>/dev/null || true

  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
  touch "$TUNNEL_NGINX_MAP"

  if [[ ! -f "/etc/nginx/tunnel_map.conf" ]]; then
    cat > "/etc/nginx/tunnel_map.conf" <<EOF
map \$host \$fire_tunnel_port {
    default "";
    include $TUNNEL_NGINX_MAP;
}
EOF
  fi

  local domain_regex="${input_domain//./\\.}"
  local vhost_file="/etc/nginx/sites-available/fire-tunnel.conf"
  cat > "$vhost_file" <<EOF
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $input_domain "~^[a-f0-9]{8}-tunnel\\.${domain_regex}\$";

    ssl_certificate ${input_cert:-/etc/ssl/certs/ssl-cert-snakeoil.pem};
    ssl_certificate_key ${input_key:-/etc/ssl/private/ssl-cert-snakeoil.key};

    location / {
        if (\$fire_tunnel_port = "") {
            default_type text/html;
            return 404 '<!DOCTYPE html><html><head><title>Tunnel Inactive</title></head><body style="font-family:system-ui,-apple-system,sans-serif; text-align:center; padding-top:100px; background:#0d1117; color:#c9d1d9;"><h1>404 &mdash; Tunnel Inactive</h1><p>The requested Fire PM tunnel is inactive or does not exist.</p></body></html>\n';
        }

        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://127.0.0.1:\$fire_tunnel_port;
    }
}
EOF

  ln -sf "$vhost_file" /etc/nginx/sites-enabled/fire-tunnel.conf 2>/dev/null || true

  if command -v nginx &>/dev/null; then
    nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || warn "Nginx configuration generated. Run 'sudo nginx -t && sudo systemctl reload nginx' after configuring valid SSL certificates."
  fi

  success "Custom tunnel domain configured for ${CYAN}$input_domain${NC}"
  echo -e "  You can now open tunnels with: ${YELLOW}fire tunnel open <port>${NC}\n"
}

action_tunnel_open() {
  local port=""
  local provider_opt=""

  for arg in "${ARGS[@]}"; do
    case "$arg" in
      --provider=*)
        provider_opt="${arg#*=}"
        ;;
      --quick)
        provider_opt="quick"
        ;;
      --custom|--nginx)
        provider_opt="custom"
        ;;
      *)
        if [[ -z "$port" && "$arg" =~ ^[0-9]+$ ]]; then
          port="$arg"
        fi
        ;;
    esac
  done

  for ((i=0; i<${#ARGS[@]}; i++)); do
    if [[ "${ARGS[i]}" == "--provider" && $((i+1)) -lt ${#ARGS[@]} ]]; then
      provider_opt="${ARGS[i+1]}"
    fi
  done

  [[ -z "$port" ]] && { error "Usage: fire tunnel open <port> [--provider quick|custom]"; exit 1; }
  validate_tunnel_port "$port" || { error "Invalid port: $port"; exit 1; }
  local_port_is_reachable "$port" || { error "Nothing is listening on localhost:$port"; exit 1; }

  ensure_tunnel_dir

  # Check if tunnel already active for this port
  if load_active_tunnel_state "$port"; then
    success "Tunnel already active on ${CYAN}localhost:$port${NC}"
    echo -e "  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}URL:${NC} ${CYAN}${BOLD}$TUNNEL_STATE_URL${NC}"
    echo -e "  ${GREY}⚡${NC} ${GREY}${BOLD}Provider:${NC} ${GREY}${TUNNEL_STATE_PROVIDER:-quick}${NC}"
    echo "$TUNNEL_STATE_URL"
    return
  fi

  remove_tunnel_state "$port" 1
  local start_ts
  start_ts=$(date +%s)

  # Determine provider: command flag overrides config; otherwise if customDomain configured, use custom, else quick.
  local chosen_provider="$provider_opt"
  if [[ -z "$chosen_provider" ]]; then
    if [[ -n "$TUNNEL_BASE_DOMAIN" && "$TUNNEL_DEFAULT_PROVIDER" == "custom" ]]; then
      chosen_provider="custom"
    else
      chosen_provider="quick"
    fi
  fi

  case "$chosen_provider" in
    custom|nginx)
      open_custom_tunnel "$port" "$start_ts"
      ;;
    quick|cloudflare|*)
      open_quick_tunnel "$port" "$start_ts"
      ;;
  esac
}

action_tunnel_list() {
  local any_active=0
  local current_ts
  local age="-"
  local url=""
  local file=""
  local status_label=""
  local status_color="$GREEN"
  local total=0
  local active_count=0
  local pending_count=0
  local json_mode=0
  local json_tunnels=()

  for arg in "${ARGS[@]}"; do
    if [[ "$arg" == "--json" ]]; then
      json_mode=1
    fi
  done

  # Initialize process mapping for tunnels
  declare -A PID_TO_NAME
  declare -A PORT_TO_PID
  if [[ $json_mode -eq 1 ]]; then
    local units
    units=$(get_fire_units)
    if [[ -n "$units" ]]; then
      local line pid id name
      while read -r line; do
        if [[ "$line" =~ ^MainPID=(.*)$ ]]; then
          pid="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^Id=(.*)$ ]]; then
          id="${BASH_REMATCH[1]}"
          name="$id"
          if [[ "$id" == "${PREFIX}-"* ]]; then
            name=${name#"$PREFIX-"}
            name=${name%.service}
          else
            name="${name%.service}"
          fi
          if [[ -n "$pid" && "$pid" -gt 0 ]]; then
            PID_TO_NAME[$pid]="$name"
          fi
          pid=""
        fi
      done < <(systemctl show $units --property=Id,MainPID 2>/dev/null)
    fi

    if command -v ss &>/dev/null; then
      local ss_state ss_recv ss_send ss_local ss_peer ss_proc ss_temp ss_pid
      while read -r ss_state ss_recv ss_send ss_local ss_peer ss_proc; do
        [[ "$ss_state" == "State" ]] && continue
        local port_num="${ss_local##*:}"
        ss_temp="$ss_proc"
        while [[ "$ss_temp" =~ pid=([0-9]+) ]]; do
          ss_pid="${BASH_REMATCH[1]}"
          PORT_TO_PID[$port_num]="$ss_pid"
          ss_temp="${ss_temp#*pid=$ss_pid}"
        done
      done < <(ss -lntp 2>/dev/null)
    fi
  fi

  ensure_tunnel_dir
  current_ts=$(date +%s)

  shopt -s nullglob
  local state_files=("$TUNNEL_DIR"/*.env)
  shopt -u nullglob

  if [[ ${#state_files[@]} -eq 0 ]]; then
    if [[ $json_mode -eq 1 ]]; then
      echo '{"tunnels":[],"total":0,"online":0,"pending":0}'
      return
    fi
    echo -e "\n  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}No active tunnels.${NC}\n"
    return
  fi

  for file in "${state_files[@]}"; do
    local port
    port=$(basename "$file" .env)

    load_active_tunnel_state "$port" || continue
    any_active=1
    ((total++))
    age="-"
    if [[ "$TUNNEL_STATE_START_TS" =~ ^[0-9]+$ ]]; then
      age=$(format_elapsed "$((current_ts - TUNNEL_STATE_START_TS))")
    fi

    local hash=""
    hash=$(tunnel_hash_from_url "$TUNNEL_STATE_URL" 2>/dev/null || nginx_map_get_hash_for_port "$port" 2>/dev/null || echo "")

    local raw_status="PENDING"
    if [[ -n "$TUNNEL_STATE_URL" ]]; then
      raw_status="ONLINE"
      status_label="⚡ ONLINE"
      status_color="$GREEN"
      url="${CYAN}${TUNNEL_STATE_URL}${NC}"
      ((active_count++))
    else
      status_label="⏳ PENDING"
      status_color="$ORANGE"
      url="${ORANGE}waiting for URL...${NC}"
      ((pending_count++))
    fi

    local proc_name="-"
    if [[ $json_mode -eq 1 ]]; then
      local mapped_pid="${PORT_TO_PID[$port]}"
      if [[ -n "$mapped_pid" ]]; then
        if [[ -n "${PID_TO_NAME[$mapped_pid]}" ]]; then
          proc_name="${PID_TO_NAME[$mapped_pid]}"
        elif [[ -f "/proc/$mapped_pid/comm" ]]; then
          proc_name=$(cat "/proc/$mapped_pid/comm" 2>/dev/null || echo "-")
        fi
      fi
    fi

    local prov="${TUNNEL_STATE_PROVIDER:-quick}"
    if [[ $json_mode -eq 1 ]]; then
      json_tunnels+=("{\"port\":$port,\"pid\":${TUNNEL_STATE_PID:-0},\"provider\":\"$prov\",\"age\":\"$age\",\"status\":\"$raw_status\",\"hash\":\"$hash\",\"url\":\"$TUNNEL_STATE_URL\",\"name\":\"$proc_name\"}")
    else
      if [[ $((total - 1)) -eq 0 ]]; then
        echo -e "\n  ${ORANGE}${BOLD}🔗 Active Fire Tunnels${NC}"
        echo -e "  ${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        printf "  ${GREY}${BOLD}%-8s %-10s %-10s %-12s %s${NC}\n" "PORT" "AGE" "STATUS" "PROVIDER" "URL"
      fi
      printf "  ${YELLOW}%-8s${NC} ${ORANGE}%-10s${NC} ${status_color}%-10s${NC} ${GREY}%-12s${NC} %b\n" \
        "$TUNNEL_STATE_PORT" "$age" "$status_label" "$prov" "$url"
    fi
  done

  if [[ $any_active -eq 0 ]]; then
    if [[ $json_mode -eq 1 ]]; then
      echo '{"tunnels":[],"total":0,"online":0,"pending":0}'
      return
    fi
    echo -e "\n  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}No active tunnels.${NC}\n"
    return
  fi

  if [[ $json_mode -eq 1 ]]; then
    local old_ifs="$IFS"
    IFS=","
    local tunnels_json="${json_tunnels[*]}"
    IFS="$old_ifs"
    echo "{\"tunnels\":[$tunnels_json],\"total\":$total,\"online\":$active_count,\"pending\":$pending_count}"
  else
    echo -e "  ${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}${BOLD}Total:${NC} ${YELLOW}${BOLD}$total${NC}   ${GREEN}${BOLD}Online:${NC} ${GREEN}${BOLD}$active_count${NC}   ${ORANGE}${BOLD}Pending:${NC} ${ORANGE}${BOLD}$pending_count${NC}"
    echo ""
  fi
}

action_tunnel_close() {
  local port="${ARGS[0]}"
  local hash=""
  local map_key=""

  validate_tunnel_port "$port" || { error "Usage: fire tunnel close <port>"; exit 1; }

  if read_tunnel_state "$port"; then
    # If running background quick tunnel PID
    if [[ "$TUNNEL_STATE_PID" =~ ^[0-9]+$ && "$TUNNEL_STATE_PID" -gt 0 ]]; then
      kill "$TUNNEL_STATE_PID" 2>/dev/null || true
    fi

    # If registered in Nginx map
    hash=$(tunnel_hash_from_url "$TUNNEL_STATE_URL" 2>/dev/null || nginx_map_get_hash_for_port "$port" 2>/dev/null || echo "")
    map_key=$(nginx_map_key_for_port "$port" 2>/dev/null || echo "")
    [[ -z "$map_key" && -n "$hash" ]] && map_key=$(tunnel_map_key_for_hash "$hash")
    if [[ -n "$map_key" && -f "$TUNNEL_NGINX_MAP" ]]; then
      nginx_map_remove "$map_key" 2>/dev/null || true
    fi

    remove_tunnel_state "$port" 1
    success "Tunnel on ${CYAN}localhost:$port${NC} has been ${RED}closed${NC}"
    return
  fi

  # Fallback: try to find hash in nginx map directly
  map_key=$(nginx_map_key_for_port "$port" 2>/dev/null || echo "")
  if [[ -n "$map_key" && -f "$TUNNEL_NGINX_MAP" ]]; then
    nginx_map_remove "$map_key" 2>/dev/null || true
    remove_tunnel_state "$port" 1
    success "Tunnel on ${CYAN}localhost:$port${NC} has been ${RED}closed${NC}"
    return
  fi

  warn "No active tunnel found on localhost:$port"
}

