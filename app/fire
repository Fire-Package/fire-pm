action_tunnel_open() {
  local port="${ARGS[0]}"
  local hash=""
  local map_key=""
  local url=""
  local start_ts=""

  validate_tunnel_port "$port" || { error "Usage: fire tunnel open <port>"; exit 1; }
  local_port_is_reachable "$port" || { error "Nothing is listening on localhost:$port"; exit 1; }

  ensure_tunnel_dir

  # Check if tunnel already active for this port
  if load_active_tunnel_state "$port"; then
    success "Tunnel already active on ${CYAN}localhost:$port${NC}"
    echo -e "  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}URL:${NC} ${CYAN}${BOLD}$TUNNEL_STATE_URL${NC}"
    echo "$TUNNEL_STATE_URL"
    return
  fi

  remove_tunnel_state "$port" 1

  # Generate a random 8-char hex hash
  hash=$(openssl rand -hex 4 2>/dev/null || cat /proc/sys/kernel/random/uuid | tr -d '-' | head -c 8)
  map_key=$(tunnel_map_key_for_hash "$hash")
  start_ts=$(date +%s)
  url=$(generate_tunnel_url "$hash")

  # Register in nginx map and reload.
  if ! nginx_map_add "$map_key" "$port"; then
    error "Could not update nginx tunnel map or reload nginx"
    exit 1
  fi

  # Persist state (PID=0, no background process)
  write_tunnel_state "$port" "0" "$url" "" "$start_ts"

  success "Tunnel established for ${CYAN}localhost:$port${NC}"
  echo -e "  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}URL:${NC} ${CYAN}${BOLD}$url${NC}"
  echo -e "  ${GREY}🔑${NC} ${GREY}${BOLD}Hash:${NC} ${GREY}$hash${NC}  ${GREY}🚫${NC} ${GREY}${BOLD}Close:${NC} ${GREY}fire tunnel close $port${NC}"
  echo "$url"
}

action_tunnel_list() {
  local any_active=0
  local current_ts
  local age="-"
  local url=""
  local file=""
  local status_label=""
  local status_color="$GREEN"
  local total=0
  local active_count=0
  local pending_count=0
  local json_mode=0
  local json_tunnels=()

  for arg in "${ARGS[@]}"; do
    if [[ "$arg" == "--json" ]]; then
      json_mode=1
    fi
  done

  # Initialize process mapping for tunnels
  declare -A PID_TO_NAME
  declare -A PORT_TO_PID
  if [[ $json_mode -eq 1 ]]; then
    local units=$(get_fire_units)
    if [[ -n "$units" ]]; then
      local line pid id name
      while read -r line; do
        if [[ "$line" =~ ^MainPID=(.*)$ ]]; then
          pid="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^Id=(.*)$ ]]; then
          id="${BASH_REMATCH[1]}"
          name="$id"
          if [[ "$id" == "${PREFIX}-"* ]]; then
            name=${name#"$PREFIX-"}
            name=${name%.service}
          else
            name="${name%.service}"
          fi
          if [[ -n "$pid" && "$pid" -gt 0 ]]; then
            PID_TO_NAME[$pid]="$name"
          fi
          pid=""
        fi
      done < <(systemctl show $units --property=Id,MainPID 2>/dev/null)
    fi

    if command -v ss &>/dev/null; then
      local ss_state ss_recv ss_send ss_local ss_peer ss_proc ss_temp ss_pid
      while read -r ss_state ss_recv ss_send ss_local ss_peer ss_proc; do
        [[ "$ss_state" == "State" ]] && continue
        local port_num="${ss_local##*:}"
        ss_temp="$ss_proc"
        while [[ "$ss_temp" =~ pid=([0-9]+) ]]; do
          ss_pid="${BASH_REMATCH[1]}"
          PORT_TO_PID[$port_num]="$ss_pid"
          ss_temp="${ss_temp#*pid=$ss_pid}"
        done
      done < <(ss -lntp 2>/dev/null)
    fi
  fi

  ensure_tunnel_dir
  current_ts=$(date +%s)

  shopt -s nullglob
  local state_files=("$TUNNEL_DIR"/*.env)
  shopt -u nullglob

  if [[ ${#state_files[@]} -eq 0 ]]; then
    if [[ $json_mode -eq 1 ]]; then
      echo '{"tunnels":[],"total":0,"online":0,"pending":0}'
      return
    fi
    echo -e "\n  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}No active tunnels.${NC}\n"
    return
  fi

  for file in "${state_files[@]}"; do
    local port
    port=$(basename "$file" .env)

    load_active_tunnel_state "$port" || continue
    any_active=1
    ((total++))
    age="-"
    if [[ "$TUNNEL_STATE_START_TS" =~ ^[0-9]+$ ]]; then
      age=$(format_elapsed "$((current_ts - TUNNEL_STATE_START_TS))")
    fi
    
    local hash=""
    hash=$(tunnel_hash_from_url "$TUNNEL_STATE_URL" 2>/dev/null || nginx_map_get_hash_for_port "$port" 2>/dev/null || echo "")

    local raw_status="PENDING"
    if [[ -n "$TUNNEL_STATE_URL" ]]; then
      raw_status="ONLINE"
      status_label="⚡ ONLINE"
      status_color="$GREEN"
      url="${CYAN}${TUNNEL_STATE_URL}${NC}"
      ((active_count++))
    else
      status_label="⏳ PENDING"
      status_color="$ORANGE"
      url="${ORANGE}waiting for URL...${NC}"
      ((pending_count++))
    fi

    local proc_name="-"
    if [[ $json_mode -eq 1 ]]; then
      local mapped_pid="${PORT_TO_PID[$port]}"
      if [[ -n "$mapped_pid" ]]; then
        if [[ -n "${PID_TO_NAME[$mapped_pid]}" ]]; then
          proc_name="${PID_TO_NAME[$mapped_pid]}"
        elif [[ -f "/proc/$mapped_pid/comm" ]]; then
          proc_name=$(cat "/proc/$mapped_pid/comm" 2>/dev/null || echo "-")
        fi
      fi
    fi

    if [[ $json_mode -eq 1 ]]; then
      json_tunnels+=("{\"port\":$port,\"pid\":${TUNNEL_STATE_PID:-0},\"age\":\"$age\",\"status\":\"$raw_status\",\"hash\":\"$hash\",\"url\":\"$TUNNEL_STATE_URL\",\"name\":\"$proc_name\"}")
    else
      if [[ $((total - 1)) -eq 0 ]]; then
        echo -e "\n  ${ORANGE}${BOLD}🔗 Active Fire Tunnels${NC}"
        echo -e "  ${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        printf "  ${GREY}${BOLD}%-8s %-10s %-10s %s${NC}\n" "PORT" "AGE" "STATUS" "URL"
      fi
      printf "  ${YELLOW}%-8s${NC} ${ORANGE}%-10s${NC} ${status_color}%-10s${NC} %b\n" \
        "$TUNNEL_STATE_PORT" "$age" "$status_label" "$url"
    fi
  done

  if [[ $any_active -eq 0 ]]; then
    if [[ $json_mode -eq 1 ]]; then
      echo '{"tunnels":[],"total":0,"online":0,"pending":0}'
      return
    fi
    echo -e "\n  ${ORANGE}🔗${NC} ${YELLOW}${BOLD}No active tunnels.${NC}\n"
    return
  fi

  if [[ $json_mode -eq 1 ]]; then
    local old_ifs="$IFS"
    IFS=","
    local tunnels_json="${json_tunnels[*]}"
    IFS="$old_ifs"
    echo "{\"tunnels\":[$tunnels_json],\"total\":$total,\"online\":$active_count,\"pending\":$pending_count}"
  else
    echo -e "  ${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}${BOLD}Total:${NC} ${YELLOW}${BOLD}$total${NC}   ${GREEN}${BOLD}Online:${NC} ${GREEN}${BOLD}$active_count${NC}   ${ORANGE}${BOLD}Pending:${NC} ${ORANGE}${BOLD}$pending_count${NC}"
    echo ""
  fi
}

action_tunnel_close() {
  local port="${ARGS[0]}"
  local hash=""
  local map_key=""

  validate_tunnel_port "$port" || { error "Usage: fire tunnel close <port>"; exit 1; }

  if read_tunnel_state "$port"; then
    hash=$(tunnel_hash_from_url "$TUNNEL_STATE_URL" || nginx_map_get_hash_for_port "$port")
    map_key=$(nginx_map_key_for_port "$port")
    [[ -z "$map_key" && -n "$hash" ]] && map_key=$(tunnel_map_key_for_hash "$hash")
    if [[ -n "$map_key" ]] && ! nginx_map_remove "$map_key"; then
      error "Could not update nginx tunnel map or reload nginx"
      exit 1
    fi
    remove_tunnel_state "$port" 1
    success "Tunnel on ${CYAN}localhost:$port${NC} has been ${RED}closed${NC}"
    return
  fi

  # Fallback: try to find hash in nginx map directly
  map_key=$(nginx_map_key_for_port "$port")
  if [[ -n "$map_key" ]]; then
    if ! nginx_map_remove "$map_key"; then
      error "Could not update nginx tunnel map or reload nginx"
      exit 1
    fi
    success "Tunnel on ${CYAN}localhost:$port${NC} has been ${RED}closed${NC}"
    return
  fi

  warn "No active tunnel found on localhost:$port"
}

show_tunnel_help() {
  echo -e "  ${ORANGE}${BOLD}🔗 Fire Tunnel Manager${NC}"
  echo -e "  ${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "  ${CYAN}${BOLD}Usage:${NC} fire tunnel ${YELLOW}<command>${NC} [port]"
  echo ""
  echo -e "  ${YELLOW}${BOLD}Commands:${NC}"
  echo -e "    ${GREEN}open${NC}  ${YELLOW}<port>${NC}   ⚡ Open a temporary tunnel for ${CYAN}localhost:<port>${NC}"
  echo -e "    ${GREEN}list${NC} [--json]      📋 List all active fire tunnels in JSON format"
  echo -e "    ${GREEN}close${NC} ${YELLOW}<port>${NC}   🚫 Close a running tunnel"
  echo ""
  echo -e "  ${YELLOW}${BOLD}Examples:${NC}"
  echo -e "    ${GREY}fire tunnel open 3000${NC}"
  echo -e "    ${GREY}fire tunnel list${NC}"
  echo -e "    ${GREY}fire tunnel close 3000${NC}"
  echo ""
}

action_tunnel() {
  case "$TUNNEL_CMD" in
    open)
      action_tunnel_open
      ;;
    list|ls)
      action_tunnel_list
      ;;
    close|stop)
      action_tunnel_close
      ;;
    help|--help|-h|"")
      show_tunnel_help
      ;;
    *)
      error "Unknown tunnel command: $TUNNEL_CMD"
      show_tunnel_help
      exit 1
      ;;
  esac
}

action_dashboard() {
  # If we have the python TUI and textual is installed, use it
  if [[ -f "/usr/local/bin/fire_tui.py" && -x "$VENV/bin/python" ]]; then
    # Loop to allow returning from live views or info screens
    while true; do
        rm -f /tmp/fire_tui_next_cmd
        "$VENV/bin/python" /usr/local/bin/fire_tui.py
        
        if [[ -f /tmp/fire_tui_next_cmd ]]; then
            local next_cmd=$(cat /tmp/fire_tui_next_cmd)
            rm -f /tmp/fire_tui_next_cmd
            
            # Execute the command
            if [[ "$next_cmd" == "fire "* ]]; then
                local subcmd=$(echo "$next_cmd" | cut -d' ' -f2)
                local target=$(echo "$next_cmd" | cut -d' ' -f3)
                
                case "$subcmd" in
                    live) ARGS=("$target"); action_live ;;
                    info|show) ARGS=("$target"); action_info; echo -e "\nPress Enter to return..."; read ;;
                    *) eval "$next_cmd" ;;
                esac
            else
                eval "$next_cmd"
            fi
        else
            # User quit the TUI normally
            clear
            exit 0
        fi
    done
  fi

  # Fallback Dashboard (Old Version)
  local first_run=1
  while true; do
    clear
    if [[ $first_run -eq 1 ]]; then
      animate_dashboard_intro
      first_run=0
    else
      print_dashboard_banner hot
    fi
    
    DASHBOARD_MODE=1 action_list
    print_dashboard_snapshot_line
    print_dashboard_tunnel_line
    echo ""
    
    echo -e "${BOLD}Actions:${NC}"
    echo -e "  [${GREEN}m${NC}] monit   [${GREEN}l${NC}] list    [${GREEN}s${NC}] stop    [${GREEN}r${NC}] restart"
    echo -e "  [${GREEN}i${NC}] info    [${GREEN}d${NC}] delete  [${GREEN}v${NC}] live    [${GREEN}x${NC}] doctor"
    echo -e "  [${GREEN}h${NC}] help    [${GREEN}q${NC}] quit"
    echo ""
    read -p ">> " choice
    
    case "$choice" in
      m|monit) action_monit ;;
      l|list) 
        echo -n -e "${GREY}Refreshing... ${NC}"
        sleep 0.2
        ;;
      s|stop) 
        read -p "Name to stop: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_stop && sleep 1 
        ;;
      r|restart) 
        read -p "Name to restart: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_restart && sleep 1 
        ;;
      i|info|show) 
        read -p "Name for info: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_info && read -p "Press Enter to continue..." 
        ;;
      v|live) 
        read -p "Name for live cockpit: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_live
        ;;
      x|doctor) action_doctor; read -p "Press Enter to continue..." ;;
      d|delete|del|rm) 
        read -p "Name to delete: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_delete && sleep 1 
        ;;
      h|help) show_help; read -p "Press Enter to continue..." ;;
      q|quit|exit) clear; exit 0 ;;
      *) warn "Invalid choice: $choice"; sleep 1 ;;
    esac
  done
}

show_help() {
  echo "Usage: fire <command> [options]"
  echo ""
  echo "Commands:"
  echo "  start <script>   Start a script (py, js, sh) as a service"
  echo "    --name <name>    Set a custom name"
  echo "    --env KEY=VAL    Set environment variable (repeatable)"
  echo "    -- <args>        Pass arguments to the script"
  echo "  list             List all managed processes
  status [--json]  Show status summary in JSON format"
  echo "  stop <name|all>  Stop a process"
  echo "  restart <name>   Restart a process"
  echo "  delete <name|--stopped> Delete a process or all stopped processes"
  echo "  info <name|file> Show detailed information about a process"
  echo "  show <name|file> Alias for info"
  echo "  live <name>      Open live cockpit for a process"
  echo "  doctor           Run system health diagnostics"
  echo "  logs [name]      Stream logs"
  echo "  monit            Real-time monitoring dashboard"
  echo "  migrate          Migrate legacy fire services to new format"
  echo "  tunnel open <port>  Open a tunnel at https://<hash>${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}"
  echo "  tunnel list         List active temporary tunnels"
  echo "  tunnel close <port> Close a temporary tunnel"
  echo ""
  echo "Examples:"
  echo "  fire start server.py --name api --port 8080"
  echo "  fire start app.js --env NODE_ENV=production"
  echo "  fire tunnel open 3000"
}

# ================== ROUTING ==================
if command_needs_root "$CMD"; then
  check_root
fi

TUNNEL_CMD=""
if [[ "$CMD" == "tunnel" ]]; then
  if [[ $# -gt 0 ]]; then
    TUNNEL_CMD="$1"
    shift
  fi
  ARGS=("$@")
else
  # Handle implied start if first arg is a file
  if [[ -f "$CMD" ]]; then
     ARGS+=("$CMD")
     CMD="start"
  fi

  parse_args "$@"
fi

case "$CMD" in
  start|create)  action_start ;;
  list|ls|status) action_list ;;
  stop)          action_stop ;;
  restart)       action_restart ;;
  delete|del|rm) action_delete ;;
  info|show)     action_info ;;
  live)          action_live ;;
  doctor)        action_doctor ;;
  logs|log)      action_logs ;;
  limit)         action_limit ;;
  monit)         action_monit ;;
  migrate)       action_migrate ;;
  tunnel)        action_tunnel ;;
  help|--help|-h) show_help ;;
  *)
    if [[ -z "$CMD" ]]; then
      action_dashboard
    else
      error "Unknown command: $CMD"
      show_help
    fi
    ;;
esac
