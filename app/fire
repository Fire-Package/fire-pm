action_tunnel() {
  case "$TUNNEL_CMD" in
    open|start)
      action_tunnel_open
      ;;
    list|ls)
      action_tunnel_list
      ;;
    close|stop)
      action_tunnel_close
      ;;
    setup|config)
      action_tunnel_setup
      ;;
    help|--help|-h|"")
      show_tunnel_help
      ;;
    *)
      if [[ "$TUNNEL_CMD" =~ ^[0-9]+$ ]]; then
        ARGS=("$TUNNEL_CMD" "${ARGS[@]}")
        action_tunnel_open
      else
        error "Unknown tunnel command: $TUNNEL_CMD"
        show_tunnel_help
        exit 1
      fi
      ;;
  esac
}

action_dashboard() {
  # Locate TUI script
  local tui_script=""
  if [[ -f "/usr/local/bin/fire_tui.py" ]]; then
    tui_script="/usr/local/bin/fire_tui.py"
  elif [[ -f "${WORKDIR}/tui/fire_tui.py" ]]; then
    tui_script="${WORKDIR}/tui/fire_tui.py"
  elif [[ -f "/opt/fire-pm/tui/fire_tui.py" ]]; then
    tui_script="/opt/fire-pm/tui/fire_tui.py"
  fi

  local py_bin
  py_bin=$(find_python 1)

  # If we have the python TUI and textual is installed, use it
  if [[ -n "$tui_script" && -n "$py_bin" ]] && "$py_bin" -c "import textual" &>/dev/null; then
    # Loop to allow returning from live views or info screens
    while true; do
        rm -f /tmp/fire_tui_next_cmd
        "$py_bin" "$tui_script"
        
        if [[ -f /tmp/fire_tui_next_cmd ]]; then
            local next_cmd=$(cat /tmp/fire_tui_next_cmd)
            rm -f /tmp/fire_tui_next_cmd
            
            # Execute the command
            if [[ "$next_cmd" == "fire "* ]]; then
                local subcmd=$(echo "$next_cmd" | cut -d' ' -f2)
                local target=$(echo "$next_cmd" | cut -d' ' -f3)
                
                case "$subcmd" in
                    live) ARGS=("$target"); action_live ;;
                    info|show) ARGS=("$target"); action_info; echo -e "\nPress Enter to return..."; read ;;
                    *) eval "$next_cmd" ;;
                esac
            else
                eval "$next_cmd"
            fi
        else
            # User quit the TUI normally
            clear
            exit 0
        fi
    done
  fi

  # Fallback Dashboard (Old Version)
  local first_run=1
  while true; do
    clear
    if [[ $first_run -eq 1 ]]; then
      animate_dashboard_intro
      first_run=0
    else
      print_dashboard_banner hot
    fi
    
    DASHBOARD_MODE=1 action_list
    print_dashboard_snapshot_line
    print_dashboard_tunnel_line
    echo ""
    
    echo -e "${BOLD}Actions:${NC}"
    echo -e "  [${GREEN}m${NC}] monit   [${GREEN}l${NC}] list    [${GREEN}s${NC}] stop    [${GREEN}r${NC}] restart"
    echo -e "  [${GREEN}i${NC}] info    [${GREEN}d${NC}] delete  [${GREEN}v${NC}] live    [${GREEN}x${NC}] doctor"
    echo -e "  [${GREEN}h${NC}] help    [${GREEN}q${NC}] quit"
    echo ""
    read -p ">> " choice
    
    case "$choice" in
      m|monit) action_monit ;;
      l|list) 
        echo -n -e "${GREY}Refreshing... ${NC}"
        sleep 0.2
        ;;
      s|stop) 
        read -p "Name to stop: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_stop && sleep 1 
        ;;
      r|restart) 
        read -p "Name to restart: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_restart && sleep 1 
        ;;
      i|info|show) 
        read -p "Name for info: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_info && read -p "Press Enter to continue..." 
        ;;
      v|live) 
        read -p "Name for live cockpit: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_live
        ;;
      x|doctor) action_doctor; read -p "Press Enter to continue..." ;;
      d|delete|del|rm) 
        read -p "Name to delete: " target
        [[ -n "$target" ]] && ARGS=("$target") && action_delete && sleep 1 
        ;;
      h|help) show_help; read -p "Press Enter to continue..." ;;
      q|quit|exit) clear; exit 0 ;;
      *) warn "Invalid choice: $choice"; sleep 1 ;;
    esac
  done
}

# ================== UPDATE ==================

action_update() {
  # Find the Fire PM source directory
  local source_dir=""
  local candidates=("/opt/fire-pm" "/usr/local/share/fire-pm")

  # Check if the running script itself is inside a git repo
  local script_path
  script_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "")"
  if [[ -n "$script_path" ]]; then
    local script_dir
    script_dir="$(dirname "$script_path")"
    # If script is at /usr/local/bin/fire, check common source dirs
    # If script is inside a repo (e.g. /opt/fire-pm/app/fire), use that
    if [[ -d "$script_dir/../.git" ]]; then
      candidates=("$(cd "$script_dir/.." && pwd)" "${candidates[@]}")
    fi
  fi

  for dir in "${candidates[@]}"; do
    if [[ -d "$dir/.git" && -f "$dir/app/fire" && -f "$dir/install.sh" ]]; then
      source_dir="$dir"
      break
    fi
  done

  if [[ -z "$source_dir" ]]; then
    # No existing clone found — clone fresh into /opt/fire-pm
    info "No existing Fire PM installation found. Cloning into /opt/fire-pm..."
    source_dir="/opt/fire-pm"
    mkdir -p /opt
    git clone https://github.com/Fire-Package/fire-pm.git "$source_dir"
  fi

  info "Updating Fire PM from ${CYAN}${source_dir}${NC}"

  # Record current commit
  local old_commit
  old_commit=$(git -C "$source_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")

  # Pull latest
  echo ""
  git -C "$source_dir" fetch --all --prune 2>/dev/null || true
  if ! git -C "$source_dir" pull --rebase 2>/dev/null; then
    # If rebase fails (local changes), try merge
    git -C "$source_dir" rebase --abort 2>/dev/null || true
    git -C "$source_dir" pull --ff-only 2>/dev/null || {
      error "Could not pull latest changes. You may have local modifications in $source_dir"
      error "Resolve conflicts manually, then re-run: fire update"
      exit 1
    }
  fi

  local new_commit
  new_commit=$(git -C "$source_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")

  if [[ "$old_commit" == "$new_commit" ]]; then
    success "Already up to date (${GREY}${old_commit}${NC})"
    return 0
  fi

  echo ""
  info "Updated: ${YELLOW}${old_commit}${NC} → ${GREEN}${new_commit}${NC}"
  echo ""

  # Show what changed
  echo -e "  ${BOLD}Changes:${NC}"
  git -C "$source_dir" log --oneline "${old_commit}..${new_commit}" 2>/dev/null | while read -r line; do
    echo -e "    ${CYAN}•${NC} $line"
  done
  echo ""

  # Re-run installer
  info "Re-running installer..."
  echo ""
  bash "$source_dir/install.sh" "$@"
}

# ================== SAVE & RESTORE ==================

action_save() {
  local target_file="${ARGS[0]:-/etc/fire-pm/dump.json}"
  local json_mode=$JSON_OPT

  python3 - <<PYEOF
import os, sys, glob, json, subprocess

target_path = "$target_file"
target_dir = os.path.dirname(os.path.abspath(target_path))
if not os.path.exists(target_dir):
    try:
        os.makedirs(target_dir, exist_ok=True)
    except Exception as e:
        if not $json_mode:
            print(f"\033[0;31m✖\033[0m Failed to create directory {target_dir}: {e}")
        else:
            print(json.dumps({"success": False, "error": str(e)}))
        sys.exit(1)

service_files = sorted(glob.glob("/etc/systemd/system/fire-*.service"))
# Filter out templates and backups
service_files = [f for f in service_files if not f.endswith("@.service") and not f.endswith(".bak") and not f.endswith("~")]

services = []

for sfile in service_files:
    fname = os.path.basename(sfile)
    name = fname[len("fire-"):-len(".service")]
    
    try:
        with open(sfile, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
    except Exception:
        continue
    
    # Parse ini lines
    desc = ""
    user = "root"
    workdir = "/"
    exec_start = ""
    env_file = ""
    envs = []
    mem_max = ""
    cpu_quota = ""
    restart = "always"
    restart_sec = "3"
    
    for line in content.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith("Description="):
            desc = line.split("=", 1)[1].strip()
        elif line.startswith("User="):
            user = line.split("=", 1)[1].strip()
        elif line.startswith("WorkingDirectory="):
            workdir = line.split("=", 1)[1].strip()
        elif line.startswith("ExecStart="):
            exec_start = line.split("=", 1)[1].strip()
        elif line.startswith("EnvironmentFile="):
            env_file = line.split("=", 1)[1].strip()
        elif line.startswith("Environment="):
            raw_env = line.split("=", 1)[1].strip()
            if raw_env.startswith('"') and raw_env.endswith('"'):
                raw_env = raw_env[1:-1]
            envs.append(raw_env)
        elif line.startswith("MemoryMax="):
            mem_max = line.split("=", 1)[1].strip()
        elif line.startswith("CPUQuota="):
            cpu_quota = line.split("=", 1)[1].strip()
        elif line.startswith("Restart="):
            restart = line.split("=", 1)[1].strip()
        elif line.startswith("RestartSec="):
            restart_sec = line.split("=", 1)[1].strip()

    if not exec_start:
        continue

    # Get status and enabled
    status_proc = subprocess.run(["systemctl", "is-active", fname], capture_output=True, text=True)
    status = status_proc.stdout.strip()
    
    enabled_proc = subprocess.run(["systemctl", "is-enabled", fname], capture_output=True, text=True)
    enabled = enabled_proc.stdout.strip() == "enabled"

    services.append({
        "name": name,
        "description": desc,
        "user": user,
        "workingDirectory": workdir,
        "execStart": exec_start,
        "environmentFile": env_file,
        "environments": envs,
        "memoryMax": mem_max,
        "cpuQuota": cpu_quota,
        "restart": restart,
        "restartSec": restart_sec,
        "enabled": enabled,
        "status": status
    })

dump_data = {
    "version": "1.0",
    "savedAt": subprocess.getoutput("date -u +\"%Y-%m-%dT%H:%M:%SZ\""),
    "count": len(services),
    "services": services
}

try:
    with open(target_path, 'w', encoding='utf-8') as f:
        json.dump(dump_data, f, indent=2)
    os.chmod(target_path, 0o666)
except Exception as e:
    if not $json_mode:
        print(f"\033[0;31m✖\033[0m Failed to write dump file: {e}")
    else:
        print(json.dumps({"success": False, "error": str(e)}))
    sys.exit(1)

if $json_mode:
    print(json.dumps({"success": True, "path": target_path, "count": len(services), "services": services}))
else:
    if not services:
        print("\033[1;33m⚠\033[0m No managed fire services found to save.")
        print(f"  Empty snapshot written to \033[0;36m{target_path}\033[0m")
    else:
        print(f"\n  \033[1m💾 Saved Fire PM Process Snapshot\033[0m")
        print(f"  \033[0;90m{'━' * 76}\033[0m")
        print(f"  \033[1m{('NAME'):<18} {('USER'):<12} {('STATUS'):<12} {('COMMAND')}\033[0m")
        for s in services:
            st = s['status'].upper()
            if st == "ACTIVE":
                st_str = "\033[0;32m● ONLINE\033[0m   "
            else:
                st_str = f"\033[0;31m○ {st[:8]:<8}\033[0m "
            
            cmd_disp = s['execStart']
            if len(cmd_disp) > 36:
                cmd_disp = cmd_disp[:33] + "..."
            print(f"  {s['name']:<18} {s['user']:<12} {st_str} {cmd_disp}")
        print(f"  \033[0;90m{'━' * 76}\033[0m")
        print(f"  \033[0;32m✔\033[0m Successfully saved \033[1m{len(services)}\033[0m process(es) to \033[0;36m{target_path}\033[0m\n")
PYEOF
}

action_restore() {
  local target_file="${ARGS[0]:-/etc/fire-pm/dump.json}"
  local json_mode=$JSON_OPT

  if [[ ! -f "$target_file" ]]; then
    if [[ $json_mode -eq 1 ]]; then
      echo '{"success":false,"error":"Dump file not found"}'
    else
      error "Dump file not found: $target_file"
      echo -e "  Run ${YELLOW}fire save${NC} first to create a process snapshot."
    fi
    return 1
  fi

  python3 - <<PYEOF
import os, sys, json, subprocess

target_path = "$target_file"

try:
    with open(target_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
except Exception as e:
    if not $json_mode:
        print(f"\033[0;31m✖\033[0m Failed to parse dump file: {e}")
    else:
        print(json.dumps({"success": False, "error": str(e)}))
    sys.exit(1)

services = data.get("services", [])
if not services:
    if not $json_mode:
        print(f"\033[1;33m⚠\033[0m No services found in dump file: {target_path}")
    else:
        print(json.dumps({"success": True, "count": 0, "restored": []}))
    sys.exit(0)

restored = []

for s in services:
    name = s.get("name", "").strip()
    exec_start = s.get("execStart", "").strip()
    if not name or not exec_start:
        continue
    
    raw_name = s.get("description", "").replace("Fire Service:", "").strip() or name
    user = s.get("user", "root")
    workdir = s.get("workingDirectory", "/")
    env_file = s.get("environmentFile", "")
    envs = s.get("environments", [])
    mem_max = s.get("memoryMax", "")
    cpu_quota = s.get("cpuQuota", "")
    restart = s.get("restart", "always")
    restart_sec = s.get("restartSec", "3")
    
    svc_file = f"/etc/systemd/system/fire-{name}.service"
    
    # Build unit content
    lines = [
        "[Unit]",
        f"Description=Fire Service: {raw_name}",
        "After=network.target",
        "StartLimitBurst=15",
        "StartLimitIntervalSec=30m",
        "",
        "[Service]",
        "Type=simple",
        f"User={user}",
        f"WorkingDirectory={workdir}"
    ]
    
    if env_file:
        lines.append(f"EnvironmentFile={env_file}")
    
    for e in envs:
        lines.append(f"Environment=\"{e}\"")
        
    lines.append(f"ExecStart={exec_start}")
    lines.append(f"Restart={restart}")
    lines.append(f"RestartSec={restart_sec}")
    lines.append("RestartMaxDelaySec=2m")
    lines.append("RestartSteps=5")
    
    if mem_max:
        lines.append(f"MemoryMax={mem_max}")
    if cpu_quota:
        lines.append(f"CPUQuota={cpu_quota}")
        
    lines.append("StandardOutput=journal")
    lines.append("StandardError=journal")
    lines.append(f"SyslogIdentifier=fire-{name}")
    lines.append("")
    lines.append("[Install]")
    lines.append("WantedBy=multi-user.target")
    lines.append("")
    
    try:
        with open(svc_file, 'w', encoding='utf-8') as f:
            f.write("\n".join(lines))
    except Exception as e:
        if not $json_mode:
            print(f"\033[0;31m✖\033[0m Failed writing unit for {name}: {e}")
        continue
    
    restored.append(name)

subprocess.run(["systemctl", "daemon-reload"], check=False)

results = []
for name in restored:
    svc_name = f"fire-{name}.service"
    subprocess.run(["systemctl", "enable", svc_name], capture_output=True, text=True)
    start_proc = subprocess.run(["systemctl", "restart", svc_name], capture_output=True, text=True)
    status_proc = subprocess.run(["systemctl", "is-active", svc_name], capture_output=True, text=True)
    st = status_proc.stdout.strip()
    results.append({"name": name, "status": st, "success": start_proc.returncode == 0})

if $json_mode:
    print(json.dumps({"success": True, "path": target_path, "count": len(results), "restored": results}))
else:
    print(f"\n  \033[1m🔄 Resurrected Fire PM Processes\033[0m")
    print(f"  \033[0;90m{'━' * 76}\033[0m")
    print(f"  \033[1m{('NAME'):<18} {('STATUS'):<14} {('ACTION')}\033[0m")
    for r in results:
        if r['status'] == "active":
            st_str = "\033[0;32m✔ ACTIVE\033[0m     "
        else:
            st_str = f"\033[0;31m✖ {r['status'].upper():<10}\033[0m"
        print(f"  {r['name']:<18} {st_str} Started and enabled on boot")
    print(f"  \033[0;90m{'━' * 76}\033[0m")
    print(f"  \033[0;32m✔\033[0m Successfully restored \033[1m{len(results)}\033[0m process(es) from \033[0;36m{target_path}\033[0m\n")
PYEOF
}

