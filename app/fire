#!/bin/bash

# ================== CONFIGURATION ==================
VENV="${VENV:-${VIRTUAL_ENV:-}}"
RUN_USER="${RUN_USER:-${SUDO_USER:-root}}"
WORKDIR=$(pwd)
SYSTEM_DIR="/etc/systemd/system"
PREFIX="fire"
TUNNEL_DIR="${TUNNEL_DIR:-/tmp/fire-tunnels}"
TUNNEL_DOMAIN="${TUNNEL_DOMAIN:-}"
TUNNEL_BASE_DOMAIN="${TUNNEL_BASE_DOMAIN:-}"
TUNNEL_HOST_SUFFIX="${TUNNEL_HOST_SUFFIX:--tunnel}"
TUNNEL_NGINX_MAP="${TUNNEL_NGINX_MAP:-/etc/nginx/tunnels.map}"
TUNNEL_DEFAULT_PROVIDER="${TUNNEL_DEFAULT_PROVIDER:-quick}"

# Load tunnel configuration from /etc/fire-pm/config.json if available
if [[ -f "/etc/fire-pm/config.json" ]]; then
  _cfg_dom=$(python3 -c "import json; c=json.load(open('/etc/fire-pm/config.json')); print(c.get('tunnel', {}).get('domain', ''))" 2>/dev/null || true)
  if [[ -n "$_cfg_dom" ]]; then
    TUNNEL_BASE_DOMAIN="$_cfg_dom"
    TUNNEL_DOMAIN="tunnel.$_cfg_dom"
  fi
  _cfg_prov=$(python3 -c "import json; c=json.load(open('/etc/fire-pm/config.json')); print(c.get('tunnel', {}).get('provider', ''))" 2>/dev/null || true)
  if [[ -n "$_cfg_prov" ]]; then
    TUNNEL_DEFAULT_PROVIDER="$_cfg_prov"
  fi
fi

# ================== COLORS & STYLING ==================
RED='\033[0;31m'
L_RED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[38;5;208m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ================== UTILS ==================
info() { echo -e "${BLUE}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✔${NC} $1"; }
error() { echo -e "${RED}✖${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }

type_text() {
  local text="$1"
  local delay="${2:-0.02}"
  for (( i=0; i<${#text}; i++ )); do
    if [[ "${INTRO_SKIP:-0}" -eq 1 ]]; then
      echo -n "${text:$i}"
      break
    fi
    echo -n "${text:$i:1}"
    animation_pause "$delay" || true
  done
}

# Finds the best available Python interpreter with fallback priority:
# 1. Active virtualenv ($VIRTUAL_ENV/bin/python or explicit $VENV/bin/python)
# 2. Local directory venvs (.venv/bin/python, venv/bin/python, env/bin/python, /opt/fire-pm/venv)
# 3. System python3 / python
find_python() {
  local prefer_textual="${1:-0}"

  _test_py() {
    local py="$1"
    if [[ -n "$py" && -x "$py" ]]; then
      if [[ "$prefer_textual" -eq 1 ]]; then
        if "$py" -c "import textual" &>/dev/null; then
          echo "$py"
          return 0
        fi
      else
        echo "$py"
        return 0
      fi
    fi
    return 1
  }

  # 1. Active virtual environment
  if [[ -n "$VIRTUAL_ENV" ]] && _test_py "$VIRTUAL_ENV/bin/python"; then
    return 0
  fi
  if [[ -n "$VENV" ]] && _test_py "$VENV/bin/python"; then
    return 0
  fi

  # 2. Local directory venvs
  local candidate_venvs=("$WORKDIR/.venv" "$WORKDIR/venv" "$WORKDIR/env" "/opt/fire-pm/venv")
  for cv in "${candidate_venvs[@]}"; do
    if _test_py "$cv/bin/python"; then
      return 0
    fi
  done

  # 3. System python3 / python
  if command -v python3 &>/dev/null; then
    local sys_py3
    sys_py3=$(command -v python3)
    if _test_py "$sys_py3"; then
      return 0
    fi
  fi
  if command -v python &>/dev/null; then
    local sys_py
    sys_py=$(command -v python)
    if _test_py "$sys_py"; then
      return 0
    fi
  fi

  # Fallback if prefer_textual was 1 and none had textual
  if [[ "$prefer_textual" -eq 1 ]]; then
    find_python 0
    return $?
  fi

  return 1
}

action_doctor() {
  if [[ $JSON_OPT -eq 1 ]]; then
    local score=100
    local checks=()
    
    local py_bin
    py_bin=$(find_python 0)
    if [[ -n "$py_bin" ]]; then
      local py_ver
      py_ver=$("$py_bin" -c "import sys; print('.'.join(map(str, sys.version_info[:3])))" 2>/dev/null || echo "detected")
      if [[ "$py_bin" == *"/bin/python" && "$py_bin" != "/usr/bin/python"* && "$py_bin" != "/usr/local/bin/python"* ]]; then
        local venv_dir
        venv_dir=$(dirname "$(dirname "$py_bin")")
        checks+=("{\"name\":\"Environment\",\"passed\":true,\"message\":\"Python venv found at $venv_dir (Python $py_ver)\"}")
      else
        checks+=("{\"name\":\"Environment\",\"passed\":true,\"message\":\"Python found at $py_bin (Python $py_ver)\"}")
      fi
    else
      checks+=("{\"name\":\"Environment\",\"passed\":false,\"message\":\"Python 3 runtime not found\"}")
      ((score -= 20))
    fi

    local tui_py
    tui_py=$(find_python 1)
    if [[ -n "$tui_py" ]] && "$tui_py" -c "import textual" &>/dev/null; then
      checks+=("{\"name\":\"TUI Dependencies\",\"passed\":true,\"message\":\"Textual library available\"}")
    else
      checks+=("{\"name\":\"TUI Dependencies\",\"passed\":false,\"message\":\"Textual library not installed (run: pip3 install textual)\"}")
      ((score -= 10))
    fi

    if id "$RUN_USER" &>/dev/null; then
      checks+=("{\"name\":\"Run User\",\"passed\":true,\"message\":\"User '$RUN_USER' exists\"}")
    else
      checks+=("{\"name\":\"Run User\",\"passed\":false,\"message\":\"User '$RUN_USER' does not exist\"}")
      ((score -= 20))
    fi

    local failed=$(systemctl list-units --all --plain --state=failed "${PREFIX}-*.service" 2>/dev/null | awk '{print $1}' | grep '\.service$' | wc -l)
    if [[ $failed -eq 0 ]]; then
      checks+=("{\"name\":\"Services\",\"passed\":true,\"message\":\"All fire services are healthy\"}")
    else
      checks+=("{\"name\":\"Services\",\"passed\":false,\"message\":\"$failed services have failed\"}")
      ((score -= 20))
    fi

    local disk_usage=$(df -h / | tail -n 1 | awk '{print $5}' | sed 's/%//')
    if (( disk_usage < 90 )); then
      checks+=("{\"name\":\"Disk Space\",\"passed\":true,\"message\":\"$disk_usage% used (Healthy)\"}")
    else
      checks+=("{\"name\":\"Disk Space\",\"passed\":false,\"message\":\"$disk_usage% used (Warning: Critically Low)\"}")
      ((score -= 20))
    fi

    local mem_free=$(free -m | grep Mem | awk '{print $4}')
    if (( mem_free > 50 )); then
      checks+=("{\"name\":\"Memory\",\"passed\":true,\"message\":\"${mem_free}MB free (Healthy)\"}")
    else
      checks+=("{\"name\":\"Memory\",\"passed\":false,\"message\":\"${mem_free}MB free (Warning: Very Low RAM)\"}")
      ((score -= 20))
    fi

    [[ $score -lt 0 ]] && score=0
    local old_ifs="$IFS"
    IFS=","
    local checks_json="${checks[*]}"
    IFS="$old_ifs"

    echo "{\"score\":$score,\"checks\":[$checks_json]}"
    return
  fi

  clear
  echo -e "${CYAN}${BOLD}Fire System Doctor${NC} — Diagnostic Tool"
  echo -e "${GREY}--------------------------------------------------${NC}"
  
  local score=100
  local total_checks=0
  local passed=0
  
  check() {
    ((total_checks++))
    local label="$1"
    local status="$2"
    local msg="$3"
    if [[ $status -eq 0 ]]; then
      ((passed++))
      echo -e "  [${GREEN}PASS${NC}] $label: $msg"
    else
      echo -e "  [${RED}FAIL${NC}] $label: ${RED}$msg${NC}"
      ((score -= 20))
    fi
  }

  # 1. Check Python Environment
  local py_bin
  py_bin=$(find_python 0)
  if [[ -n "$py_bin" ]]; then
    local py_ver
    py_ver=$("$py_bin" -c "import sys; print('.'.join(map(str, sys.version_info[:3])))" 2>/dev/null || echo "detected")
    if [[ "$py_bin" == *"/bin/python" && "$py_bin" != "/usr/bin/python"* && "$py_bin" != "/usr/local/bin/python"* ]]; then
      local venv_dir
      venv_dir=$(dirname "$(dirname "$py_bin")")
      check "Environment" 0 "Python venv found at $venv_dir (Python $py_ver)"
    else
      check "Environment" 0 "Python found at $py_bin (Python $py_ver)"
    fi
  else
    check "Environment" 1 "Python 3 runtime not found"
  fi

  # 2. Check TUI Dependencies
  local tui_py
  tui_py=$(find_python 1)
  if [[ -n "$tui_py" ]] && "$tui_py" -c "import textual" &>/dev/null; then
    check "TUI Dependencies" 0 "Textual library available"
  else
    check "TUI Dependencies" 1 "Textual library not found (run: pip3 install textual)"
  fi

  # 3. Check User
  if id "$RUN_USER" &>/dev/null; then
    check "Run User" 0 "User '$RUN_USER' exists"
  else
    check "Run User" 1 "User '$RUN_USER' does not exist"
  fi

  # 4. Check Failed Services
  local failed=$(systemctl list-units --all --plain --state=failed "${PREFIX}-*.service" 2>/dev/null | awk '{print $1}' | grep '\.service$' | wc -l)
  if [[ $failed -eq 0 ]]; then
    check "Services" 0 "All fire services are healthy"
  else
    check "Services" 1 "$failed services have failed"
  fi

  # 5. Check Disk Space
  local disk_usage=$(df -h / | tail -n 1 | awk '{print $5}' | sed 's/%//')
  if (( disk_usage < 90 )); then
    check "Disk Space" 0 "$disk_usage% used (Healthy)"
  else
    check "Disk Space" 1 "$disk_usage% used (Warning: Critically Low)"
  fi

  # 6. Check Memory
  local mem_free=$(free -m | grep Mem | awk '{print $4}')
  if (( mem_free > 50 )); then
    check "Memory" 0 "${mem_free}MB free (Healthy)"
  else
    check "Memory" 1 "${mem_free}MB free (Warning: Very Low RAM)"
  fi

  echo -e "${GREY}--------------------------------------------------${NC}"
  local final_color=$GREEN
  (( score < 70 )) && final_color=$YELLOW
  (( score < 40 )) && final_color=$RED
  [[ $score -lt 0 ]] && score=0
  
  echo -e "  ${BOLD}System Health Score:${NC} ${final_color}${score}%${NC} ($passed/$total_checks checks passed)"
  echo ""
}

check_root() {
  if [[ $EUID -ne 0 ]]; then
     error "This action requires root privileges (to manage systemd services)."
     exit 1
  fi
}

ensure_root() {
  if [[ $EUID -ne 0 ]]; then
    if command -v sudo &>/dev/null; then
      if sudo -n -E true 2>/dev/null; then
        exec sudo -E "$0" "$@"
      else
        exec sudo "$0" "$@"
      fi
    else
      error "This action requires root privileges. Please install sudo or run as root."
      exit 1
    fi
  fi
}

command_needs_root() {
  local cmd="$1"
  local subcmd="$2"
  case "$cmd" in
    start|create|stop|restart|delete|del|rm|limit|migrate|update|save|dump|restore|resurrect|startup|unstartup|flush)
      return 0
      ;;
    tunnel)
      case "$subcmd" in
        open|start|close|stop|setup|config)
          return 0
          ;;
        *)
          return 1
          ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac
}

get_safe_name() {
  # Convert to lowercase, remove non-alphanumeric chars
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]//g'
}

resolve_service_name() {
  local target="$1"
  [[ -z "$target" ]] && echo "" && return

  local safe_name=$(get_safe_name "$target")
  local svc_file="${SYSTEM_DIR}/${PREFIX}-${safe_name}.service"

  # 1. Exact safe name match
  if [[ -f "$svc_file" ]]; then
      basename "$svc_file"
      return
  fi

  # 2. Try safe name of basename
  local base=$(basename "$target")
  local alt_safe=$(get_safe_name "$base")
  svc_file="${SYSTEM_DIR}/${PREFIX}-${alt_safe}.service"
  if [[ -f "$svc_file" ]]; then
      basename "$svc_file"
      return
  fi

  # 3. Try to find by Description (App Name)
  local found=$(grep -l "Description=Fire Service: $target" "${SYSTEM_DIR}/${PREFIX}-"*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  # 4. Try fuzzy match by name
  found=$(ls "${SYSTEM_DIR}/${PREFIX}-"*${safe_name}*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  # 5. Try to find by ExecStart containing the target
  found=$(grep -l "ExecStart=.*$target" "${SYSTEM_DIR}/${PREFIX}-"*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  echo ""
}

format_uptime() {
  local start_ts="$1"
  [[ -z "$start_ts" ]] && echo "-" && return
  
  local start_sec=$(date -d "$start_ts" +%s 2>/dev/null)
  [[ -z "$start_sec" ]] && echo "-" && return

  local now_sec=$(date +%s)
  local diff=$((now_sec - start_sec))

  if (( diff < 60 )); then echo "${diff}s"
  elif (( diff < 3600 )); then echo "$((diff/60))m"
  else echo "$((diff/3600))h"
  fi
}

format_elapsed() {
  local total="$1"
  [[ -z "$total" || "$total" -lt 0 ]] && echo "-" && return

  if (( total < 60 )); then
    echo "${total}s"
  elif (( total < 3600 )); then
    echo "$((total/60))m"
  elif (( total < 86400 )); then
    echo "$((total/3600))h"
  else
    echo "$((total/86400))d"
  fi
}

format_mem_kb() {
  local kb="${1:-0}"
  [[ ! "$kb" =~ ^[0-9]+$ ]] && echo "0.0MB" && return
  local tenths=$(( kb * 10 / 1024 ))
  if (( tenths < 10 )); then
    echo "0.${tenths}MB"
  else
    echo "${tenths:0:-1}.${tenths: -1}MB"
  fi
}

ensure_tunnel_dir() {
  mkdir -p "$TUNNEL_DIR"
  chmod 777 "$TUNNEL_DIR" 2>/dev/null || chmod 755 "$TUNNEL_DIR" 2>/dev/null || true
}

is_pid_running() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -d "/proc/$pid" ]] || kill -0 "$pid" 2>/dev/null
}

validate_tunnel_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( port > 0 && port < 65536 ))
}

local_port_is_reachable() {
  local port="$1"
  timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" >/dev/null 2>&1
}

tunnel_state_file() {
  echo "$TUNNEL_DIR/$1.env"
}

tunnel_log_file() {
  echo "$TUNNEL_DIR/$1.log"
}

reset_tunnel_state() {
  TUNNEL_STATE_PORT=""
  TUNNEL_STATE_PID=""
  TUNNEL_STATE_URL=""
  TUNNEL_STATE_LOG_FILE=""
  TUNNEL_STATE_START_TS=""
  TUNNEL_STATE_PROVIDER=""
}

read_tunnel_state() {
  local port="$1"
  local state_file
  local key
  local value

  state_file=$(tunnel_state_file "$port")
  reset_tunnel_state
  [[ -f "$state_file" ]] || return 1

  while IFS='=' read -r key value; do
    case "$key" in
      PORT) TUNNEL_STATE_PORT="$value" ;;
      PID) TUNNEL_STATE_PID="$value" ;;
      URL) TUNNEL_STATE_URL="$value" ;;
      LOG_FILE) TUNNEL_STATE_LOG_FILE="$value" ;;
      START_TS) TUNNEL_STATE_START_TS="$value" ;;
      PROVIDER) TUNNEL_STATE_PROVIDER="$value" ;;
    esac
  done < "$state_file"

  [[ "$TUNNEL_STATE_PORT" == "$port" ]] || return 1
}

write_tunnel_state() {
  local port="$1"
  local pid="$2"
  local url="$3"
  local log_file="$4"
  local start_ts="$5"
  local provider="${6:-quick}"
  local state_file

  ensure_tunnel_dir
  state_file=$(tunnel_state_file "$port")

  cat > "$state_file" <<EOF
PORT=$port
PID=$pid
URL=$url
LOG_FILE=$log_file
START_TS=$start_ts
PROVIDER=$provider
EOF
  chmod 666 "$state_file" 2>/dev/null || chmod 644 "$state_file" 2>/dev/null || true
  if [[ -n "$log_file" && -f "$log_file" ]]; then
    chmod 666 "$log_file" 2>/dev/null || chmod 644 "$log_file" 2>/dev/null || true
  fi
}

remove_tunnel_state() {
  local port="$1"
  local remove_log="${2:-0}"
  local state_file
  local known_log=""

  state_file=$(tunnel_state_file "$port")
  if read_tunnel_state "$port"; then
    known_log="$TUNNEL_STATE_LOG_FILE"
  fi

  rm -f "$state_file"
  if [[ "$remove_log" -eq 1 ]]; then
    rm -f "$known_log" "$(tunnel_log_file "$port")"
  fi
  reset_tunnel_state
}

generate_tunnel_url() {
  local hash="$1"
  if [[ -n "$TUNNEL_BASE_DOMAIN" ]]; then
    echo "https://${hash}${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}"
  else
    echo "https://${hash}${TUNNEL_HOST_SUFFIX}.tunnel.local"
  fi
}

load_active_tunnel_state() {
  local port="$1"
  local hash=""
  local host=""
  local mapped_port=""

  read_tunnel_state "$port" || return 1

  # 1. Quick Tunnel (Cloudflare or background process)
  if [[ "$TUNNEL_STATE_PROVIDER" == "quick" || ("$TUNNEL_STATE_PID" =~ ^[0-9]+$ && "$TUNNEL_STATE_PID" -gt 0) ]]; then
    if is_pid_running "$TUNNEL_STATE_PID"; then
      return 0
    else
      remove_tunnel_state "$port" 1
      return 1
    fi
  fi

  # 2. Custom Nginx-based tunnel
  host="${TUNNEL_STATE_URL#https://}"
  if [[ -n "$TUNNEL_BASE_DOMAIN" && "$host" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    mapped_port=$(awk -v h="$host" '$1 == h { gsub(/;/, "", $2); print $2; exit }' "$TUNNEL_NGINX_MAP" 2>/dev/null)
    if [[ "$mapped_port" == "$port" ]]; then
      return 0
    fi
  fi

  if [[ -f "$TUNNEL_NGINX_MAP" ]]; then
    mapped_port=$(awk -v h="$host" '$1 == h { gsub(/;/, "", $2); print $2; exit }' "$TUNNEL_NGINX_MAP" 2>/dev/null)
    if [[ "$mapped_port" == "$port" ]]; then
      return 0
    fi
  fi

  remove_tunnel_state "$port" 1
  return 1
}

tunnel_map_key_for_hash() {
  local hash="$1"
  echo "${hash}${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}"
}

tunnel_hash_from_url() {
  local url="$1"
  local host="${url#https://}"

  if [[ "$host" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    echo "${host%%${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}}"
    return 0
  fi

  if [[ "$host" =~ ^[a-f0-9]{8}\.${TUNNEL_DOMAIN}$ ]]; then
    echo "${host%%.*}"
    return 0
  fi

  if [[ "$url" =~ ^https://${TUNNEL_DOMAIN}/[a-f0-9]{8}$ ]]; then
    echo "${url##*/}"
    return 0
  fi

  return 1
}

nginx_map_key_for_port() {
  local port="$1"
  awk -v p="$port" '{ gsub(/;/, "", $2); if ($2 == p) { print $1; exit } }' "$TUNNEL_NGINX_MAP" 2>/dev/null
}

nginx_map_get_hash_for_port() {
  local port="$1"
  local key=""

  key=$(nginx_map_key_for_port "$port")
  [[ -n "$key" ]] || return 1

  if [[ "$key" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    echo "${key%%${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}}"
  elif [[ "$key" =~ ^[a-f0-9]{8}\.${TUNNEL_DOMAIN}$ ]]; then
    echo "${key%%.*}"
  else
    echo "$key"
  fi
}

nginx_map_add() {
  local key="$1"
  local port="$2"

  touch "$TUNNEL_NGINX_MAP" 2>/dev/null || {
    error "Cannot write tunnel map: $TUNNEL_NGINX_MAP"
    return 1
  }

  # Keep one live mapping per host/hash and per local port.
  sed -i "/^${key//./\\.} /d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\}${TUNNEL_HOST_SUFFIX//./\\.}\\.${TUNNEL_BASE_DOMAIN//./\\.} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\}\\.${TUNNEL_DOMAIN//./\\.} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  echo "${key} ${port};" >> "$TUNNEL_NGINX_MAP"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
}

nginx_map_remove() {
  local key="$1"
  [[ -f "$TUNNEL_NGINX_MAP" ]] || return 0
  sed -i "/^${key//./\\.} /d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
}

stop_background_process() {
  local pid="$1"
  local attempts=0

  is_pid_running "$pid" || return 0
  kill "$pid" 2>/dev/null || return 1

  while (( attempts < 5 )); do
    is_pid_running "$pid" || return 0
    sleep 1
    ((attempts++))
  done

  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  ! is_pid_running "$pid"
}

animation_pause() {
  local delay="${1:-0.05}"

  if [[ "${INTRO_SKIP:-0}" -eq 1 ]]; then
    return 1
  fi

  if [[ ! -t 0 ]]; then
    sleep "$delay"
    return 0
  fi

  local key
  if read -rsn1 -t "$delay" key 2>/dev/null; then
    INTRO_SKIP=1
    return 1
  fi

  return 0
}

get_fire_units() {
  {
    systemctl list-units --all --no-legend --plain "${PREFIX}-*.service" 2>/dev/null | awk '{print $1}' | grep '\.service$' | grep -v "${PREFIX}-reload@"
    ls -1 ${SYSTEM_DIR}/${PREFIX}-*.service 2>/dev/null | xargs -n1 basename 2>/dev/null | grep -v "${PREFIX}-reload@"
    local legacy_list=$(grep -l "fire-managed Python Service" /etc/systemd/system/*.service 2>/dev/null)
    [[ -n "$legacy_list" ]] && echo "$legacy_list" | xargs -n1 basename | grep -v "${PREFIX}-reload@"
  } | sort -u
}

get_dashboard_snapshot() {
  local total=0
  local online=0
  local failed=0
  local total_mem_kb=0
  local units=$(get_fire_units)

  for svc in $units; do
    [[ -z "$svc" ]] && continue
    ((total++))

    local props=$(systemctl show --property=ActiveState,MainPID -- "$svc" 2>/dev/null)
    local state=$(echo "$props" | grep ActiveState | cut -d= -f2)
    local pid_val=$(echo "$props" | grep MainPID | cut -d= -f2)

    if [[ "$state" == "active" ]]; then
      ((online++))
      if [[ "$pid_val" =~ ^[0-9]+$ && "$pid_val" -gt 0 ]]; then
        local rss=$(ps -p "$pid_val" -o rss= 2>/dev/null | awk '{print $1}')
        [[ "$rss" =~ ^[0-9]+$ ]] && total_mem_kb=$((total_mem_kb + rss))
      fi
    elif [[ "$state" == "failed" ]]; then
      ((failed++))
    fi
  done

  local total_mem_mb=$(format_mem_kb "$total_mem_kb")
  printf "%s|%s|%s|%s\n" "$total" "$online" "$failed" "$total_mem_mb"
}

