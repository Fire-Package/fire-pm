#!/bin/bash

# ================== CONFIGURATION ==================
VENV="${VENV:-/root/myenv}"
RUN_USER="${RUN_USER:-root}"
WORKDIR=$(pwd)
SYSTEM_DIR="/etc/systemd/system"
PREFIX="fire"
TUNNEL_DIR="${TUNNEL_DIR:-/tmp/fire-tunnels}"
TUNNEL_DOMAIN="${TUNNEL_DOMAIN:-tunnel.abhinav.eu.cc}"
TUNNEL_BASE_DOMAIN="${TUNNEL_BASE_DOMAIN:-abhinav.eu.cc}"
TUNNEL_HOST_SUFFIX="${TUNNEL_HOST_SUFFIX:--tunnel}"
TUNNEL_NGINX_MAP="${TUNNEL_NGINX_MAP:-/etc/nginx/tunnels.map}"

# ================== COLORS & STYLING ==================
RED='\033[0;31m'
L_RED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[38;5;208m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ================== UTILS ==================
info() { echo -e "${BLUE}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✔${NC} $1"; }
error() { echo -e "${RED}✖${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }

type_text() {
  local text="$1"
  local delay="${2:-0.02}"
  for (( i=0; i<${#text}; i++ )); do
    if [[ "${INTRO_SKIP:-0}" -eq 1 ]]; then
      echo -n "${text:$i}"
      break
    fi
    echo -n "${text:$i:1}"
    animation_pause "$delay" || true
  done
}

action_doctor() {
  if [[ $JSON_OPT -eq 1 ]]; then
    local score=100
    local checks=()
    
    if [[ -d "$VENV" ]]; then
      checks+=("{\"name\":\"Environment\",\"passed\":true,\"message\":\"Python venv found at $VENV\"}")
    else
      checks+=("{\"name\":\"Environment\",\"passed\":false,\"message\":\"Python venv NOT found at $VENV\"}")
      ((score -= 20))
    fi

    if id "$RUN_USER" &>/dev/null; then
      checks+=("{\"name\":\"Run User\",\"passed\":true,\"message\":\"User '$RUN_USER' exists\"}")
    else
      checks+=("{\"name\":\"Run User\",\"passed\":false,\"message\":\"User '$RUN_USER' does not exist\"}")
      ((score -= 20))
    fi

    local failed=$(systemctl list-units --all --plain --state=failed "${PREFIX}-*.service" 2>/dev/null | awk '{print $1}' | grep '\.service$' | wc -l)
    if [[ $failed -eq 0 ]]; then
      checks+=("{\"name\":\"Services\",\"passed\":true,\"message\":\"All fire services are healthy\"}")
    else
      checks+=("{\"name\":\"Services\",\"passed\":false,\"message\":\"$failed services have failed\"}")
      ((score -= 20))
    fi

    local disk_usage=$(df -h / | tail -n 1 | awk '{print $5}' | sed 's/%//')
    if (( disk_usage < 90 )); then
      checks+=("{\"name\":\"Disk Space\",\"passed\":true,\"message\":\"$disk_usage% used (Healthy)\"}")
    else
      checks+=("{\"name\":\"Disk Space\",\"passed\":false,\"message\":\"$disk_usage% used (Warning: Critically Low)\"}")
      ((score -= 20))
    fi

    local mem_free=$(free -m | grep Mem | awk '{print $4}')
    if (( mem_free > 50 )); then
      checks+=("{\"name\":\"Memory\",\"passed\":true,\"message\":\"${mem_free}MB free (Healthy)\"}")
    else
      checks+=("{\"name\":\"Memory\",\"passed\":false,\"message\":\"${mem_free}MB free (Warning: Very Low RAM)\"}")
      ((score -= 20))
    fi

    [[ $score -lt 0 ]] && score=0
    local old_ifs="$IFS"
    IFS=","
    local checks_json="${checks[*]}"
    IFS="$old_ifs"

    echo "{\"score\":$score,\"checks\":[$checks_json]}"
    return
  fi

  clear
  echo -e "${CYAN}${BOLD}Fire System Doctor${NC} — Diagnostic Tool"
  echo -e "${GREY}--------------------------------------------------${NC}"
  
  local score=100
  local total_checks=0
  local passed=0
  
  check() {
    ((total_checks++))
    local label="$1"
    local status="$2"
    local msg="$3"
    if [[ $status -eq 0 ]]; then
      ((passed++))
      echo -e "  [${GREEN}PASS${NC}] $label: $msg"
    else
      echo -e "  [${RED}FAIL${NC}] $label: ${RED}$msg${NC}"
      ((score -= 20))
    fi
  }

  # 1. Check VENV
  if [[ -d "$VENV" ]]; then
    check "Environment" 0 "Python venv found at $VENV"
  else
    check "Environment" 1 "Python venv NOT found at $VENV"
  fi

  # 2. Check User
  if id "$RUN_USER" &>/dev/null; then
    check "Run User" 0 "User '$RUN_USER' exists"
  else
    check "Run User" 1 "User '$RUN_USER' does not exist"
  fi

  # 3. Check Failed Services
  local failed=$(systemctl list-units --all --plain --state=failed "${PREFIX}-*.service" | awk '{print $1}' | grep '\.service$' | wc -l)
  if [[ $failed -eq 0 ]]; then
    check "Services" 0 "All fire services are healthy"
  else
    check "Services" 1 "$failed services have failed"
  fi

  # 4. Check Disk Space
  local disk_usage=$(df -h / | tail -n 1 | awk '{print $5}' | sed 's/%//')
  if (( disk_usage < 90 )); then
    check "Disk Space" 0 "$disk_usage% used (Healthy)"
  else
    check "Disk Space" 1 "$disk_usage% used (Warning: Critically Low)"
  fi

  # 5. Check Memory
  local mem_free=$(free -m | grep Mem | awk '{print $4}')
  if (( mem_free > 50 )); then
    check "Memory" 0 "${mem_free}MB free (Healthy)"
  else
    check "Memory" 1 "${mem_free}MB free (Warning: Very Low RAM)"
  fi

  echo -e "${GREY}--------------------------------------------------${NC}"
  local final_color=$GREEN
  (( score < 70 )) && final_color=$YELLOW
  (( score < 40 )) && final_color=$RED
  [[ $score -lt 0 ]] && score=0
  
  echo -e "  ${BOLD}System Health Score:${NC} ${final_color}${score}%${NC} ($passed/$total_checks checks passed)"
  echo ""
}

check_root() {
  if [[ $EUID -ne 0 ]]; then
     error "This script must be run as root (to manage systemd services)."
     exit 1
  fi
}

command_needs_root() {
  case "$1" in
    tunnel|help|--help|-h)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

get_safe_name() {
  # Convert to lowercase, remove non-alphanumeric chars
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]//g'
}

resolve_service_name() {
  local target="$1"
  [[ -z "$target" ]] && echo "" && return

  local safe_name=$(get_safe_name "$target")
  local svc_file="${SYSTEM_DIR}/${PREFIX}-${safe_name}.service"

  # 1. Exact safe name match
  if [[ -f "$svc_file" ]]; then
      basename "$svc_file"
      return
  fi

  # 2. Try safe name of basename
  local base=$(basename "$target")
  local alt_safe=$(get_safe_name "$base")
  svc_file="${SYSTEM_DIR}/${PREFIX}-${alt_safe}.service"
  if [[ -f "$svc_file" ]]; then
      basename "$svc_file"
      return
  fi

  # 3. Try to find by Description (App Name)
  local found=$(grep -l "Description=Fire Service: $target" "${SYSTEM_DIR}/${PREFIX}-"*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  # 4. Try fuzzy match by name
  found=$(ls "${SYSTEM_DIR}/${PREFIX}-"*${safe_name}*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  # 5. Try to find by ExecStart containing the target
  found=$(grep -l "ExecStart=.*$target" "${SYSTEM_DIR}/${PREFIX}-"*.service 2>/dev/null | head -n 1)
  if [[ -n "$found" ]]; then
      basename "$found"
      return
  fi

  echo ""
}

format_uptime() {
  local start_ts="$1"
  [[ -z "$start_ts" ]] && echo "-" && return
  
  local start_sec=$(date -d "$start_ts" +%s 2>/dev/null)
  [[ -z "$start_sec" ]] && echo "-" && return

  local now_sec=$(date +%s)
  local diff=$((now_sec - start_sec))

  if (( diff < 60 )); then echo "${diff}s"
  elif (( diff < 3600 )); then echo "$((diff/60))m"
  else echo "$((diff/3600))h"
  fi
}

format_elapsed() {
  local total="$1"
  [[ -z "$total" || "$total" -lt 0 ]] && echo "-" && return

  if (( total < 60 )); then
    echo "${total}s"
  elif (( total < 3600 )); then
    echo "$((total/60))m"
  elif (( total < 86400 )); then
    echo "$((total/3600))h"
  else
    echo "$((total/86400))d"
  fi
}

format_mem_kb() {
  local kb="${1:-0}"
  [[ ! "$kb" =~ ^[0-9]+$ ]] && echo "0.0MB" && return
  local tenths=$(( kb * 10 / 1024 ))
  if (( tenths < 10 )); then
    echo "0.${tenths}MB"
  else
    echo "${tenths:0:-1}.${tenths: -1}MB"
  fi
}

ensure_tunnel_dir() {
  mkdir -p "$TUNNEL_DIR"
  chmod 700 "$TUNNEL_DIR" 2>/dev/null || true
}

is_pid_running() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

validate_tunnel_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( port > 0 && port < 65536 ))
}

local_port_is_reachable() {
  local port="$1"
  timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" >/dev/null 2>&1
}

tunnel_state_file() {
  echo "$TUNNEL_DIR/$1.env"
}

tunnel_log_file() {
  echo "$TUNNEL_DIR/$1.log"
}

reset_tunnel_state() {
  TUNNEL_STATE_PORT=""
  TUNNEL_STATE_PID=""
  TUNNEL_STATE_URL=""
  TUNNEL_STATE_LOG_FILE=""
  TUNNEL_STATE_START_TS=""
}

read_tunnel_state() {
  local port="$1"
  local state_file
  local key
  local value

  state_file=$(tunnel_state_file "$port")
  reset_tunnel_state
  [[ -f "$state_file" ]] || return 1

  while IFS='=' read -r key value; do
    case "$key" in
      PORT) TUNNEL_STATE_PORT="$value" ;;
      PID) TUNNEL_STATE_PID="$value" ;;
      URL) TUNNEL_STATE_URL="$value" ;;
      LOG_FILE) TUNNEL_STATE_LOG_FILE="$value" ;;
      START_TS) TUNNEL_STATE_START_TS="$value" ;;
    esac
  done < "$state_file"

  [[ "$TUNNEL_STATE_PORT" == "$port" ]] || return 1
}

write_tunnel_state() {
  local port="$1"
  local pid="$2"
  local url="$3"
  local log_file="$4"
  local start_ts="$5"
  local state_file

  ensure_tunnel_dir
  state_file=$(tunnel_state_file "$port")

  cat > "$state_file" <<EOF
PORT=$port
PID=$pid
URL=$url
LOG_FILE=$log_file
START_TS=$start_ts
EOF
  chmod 600 "$state_file" 2>/dev/null || true
}

remove_tunnel_state() {
  local port="$1"
  local remove_log="${2:-0}"
  local state_file
  local known_log=""

  state_file=$(tunnel_state_file "$port")
  if read_tunnel_state "$port"; then
    known_log="$TUNNEL_STATE_LOG_FILE"
  fi

  rm -f "$state_file"
  if [[ "$remove_log" -eq 1 ]]; then
    rm -f "$known_log" "$(tunnel_log_file "$port")"
  fi
  reset_tunnel_state
}

generate_tunnel_url() {
  local hash="$1"
  echo "https://${hash}${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}"
}

extract_tunnel_url() {
  # Legacy: kept for backward compat with old state files; reads URL directly
  local log_file="$1"
  [[ -f "$log_file" ]] || return 1
  cat "$log_file" 2>/dev/null | head -n 1
}

load_active_tunnel_state() {
  local port="$1"
  local hash=""
  local host=""
  local mapped_port=""

  read_tunnel_state "$port" || return 1
  # Nginx-based tunnels have no background PID; require our wildcard host and map entry.
  host="${TUNNEL_STATE_URL#https://}"
  if [[ "$host" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    hash="${host%%${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}}"
    mapped_port=$(awk -v h="$host" '$1 == h { gsub(/;/, "", $2); print $2; exit }' "$TUNNEL_NGINX_MAP" 2>/dev/null)
    [[ "$mapped_port" == "$port" ]] || {
      remove_tunnel_state "$port" 1
      return 1
    }
    return 0
  fi

  # Migrate old nested-subdomain state: https://<hash>.tunnel.domain
  if [[ "$host" =~ ^[a-f0-9]{8}\.${TUNNEL_DOMAIN}$ ]]; then
    hash="${host%%.*}"
    mapped_port=$(awk -v h="$host" '$1 == h { gsub(/;/, "", $2); print $2; exit }' "$TUNNEL_NGINX_MAP" 2>/dev/null)
    if [[ "$mapped_port" == "$port" ]]; then
      nginx_map_remove "$host" >/dev/null 2>&1 || true
      nginx_map_add "$(tunnel_map_key_for_hash "$hash")" "$port" >/dev/null 2>&1 || return 1
      TUNNEL_STATE_URL=$(generate_tunnel_url "$hash")
      write_tunnel_state "$port" "0" "$TUNNEL_STATE_URL" "" "$TUNNEL_STATE_START_TS"
      return 0
    fi
  fi

  # Migrate old path-style state: https://tunnel.domain/<hash>
  if [[ "$TUNNEL_STATE_URL" =~ ^https://${TUNNEL_DOMAIN}/[a-f0-9]{8}$ ]]; then
    hash="${TUNNEL_STATE_URL##*/}"
    mapped_port=$(awk -v h="$hash" '$1 == h { gsub(/;/, "", $2); print $2; exit }' "$TUNNEL_NGINX_MAP" 2>/dev/null)
    if [[ "$mapped_port" == "$port" ]]; then
      nginx_map_remove "$hash" >/dev/null 2>&1 || true
      nginx_map_add "$(tunnel_map_key_for_hash "$hash")" "$port" >/dev/null 2>&1 || return 1
      TUNNEL_STATE_URL=$(generate_tunnel_url "$hash")
      write_tunnel_state "$port" "0" "$TUNNEL_STATE_URL" "" "$TUNNEL_STATE_START_TS"
      return 0
    fi
  fi

  remove_tunnel_state "$port" 1
  return 1
}

tunnel_map_key_for_hash() {
  local hash="$1"
  echo "${hash}${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}"
}

tunnel_hash_from_url() {
  local url="$1"
  local host="${url#https://}"

  if [[ "$host" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    echo "${host%%${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}}"
    return 0
  fi

  if [[ "$host" =~ ^[a-f0-9]{8}\.${TUNNEL_DOMAIN}$ ]]; then
    echo "${host%%.*}"
    return 0
  fi

  if [[ "$url" =~ ^https://${TUNNEL_DOMAIN}/[a-f0-9]{8}$ ]]; then
    echo "${url##*/}"
    return 0
  fi

  return 1
}

nginx_map_key_for_port() {
  local port="$1"
  awk -v p="$port" '{ gsub(/;/, "", $2); if ($2 == p) { print $1; exit } }' "$TUNNEL_NGINX_MAP" 2>/dev/null
}

nginx_map_get_hash_for_port() {
  local port="$1"
  local key=""

  key=$(nginx_map_key_for_port "$port")
  [[ -n "$key" ]] || return 1

  if [[ "$key" =~ ^[a-f0-9]{8}${TUNNEL_HOST_SUFFIX}\.${TUNNEL_BASE_DOMAIN}$ ]]; then
    echo "${key%%${TUNNEL_HOST_SUFFIX}.${TUNNEL_BASE_DOMAIN}}"
  elif [[ "$key" =~ ^[a-f0-9]{8}\.${TUNNEL_DOMAIN}$ ]]; then
    echo "${key%%.*}"
  else
    echo "$key"
  fi
}

nginx_map_add() {
  local key="$1"
  local port="$2"

  touch "$TUNNEL_NGINX_MAP" 2>/dev/null || {
    error "Cannot write tunnel map: $TUNNEL_NGINX_MAP"
    return 1
  }

  # Keep one live mapping per host/hash and per local port.
  sed -i "/^${key//./\\.} /d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\}${TUNNEL_HOST_SUFFIX//./\\.}\\.${TUNNEL_BASE_DOMAIN//./\\.} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\}\\.${TUNNEL_DOMAIN//./\\.} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  sed -i "/^[a-f0-9]\{8\} ${port};$/d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  echo "${key} ${port};" >> "$TUNNEL_NGINX_MAP"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
}

nginx_map_remove() {
  local key="$1"
  [[ -f "$TUNNEL_NGINX_MAP" ]] || return 0
  sed -i "/^${key//./\\.} /d" "$TUNNEL_NGINX_MAP" 2>/dev/null || true
  nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
}

stop_background_process() {
  local pid="$1"
  local attempts=0

  is_pid_running "$pid" || return 0
  kill "$pid" 2>/dev/null || return 1

  while (( attempts < 5 )); do
    is_pid_running "$pid" || return 0
    sleep 1
    ((attempts++))
  done

  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  ! is_pid_running "$pid"
}

animation_pause() {
  local delay="${1:-0.05}"

  if [[ "${INTRO_SKIP:-0}" -eq 1 ]]; then
    return 1
  fi

  if [[ ! -t 0 ]]; then
    sleep "$delay"
    return 0
  fi

  local key
  if read -rsn1 -t "$delay" key 2>/dev/null; then
    INTRO_SKIP=1
    return 1
  fi

  return 0
}

get_fire_units() {
  {
    systemctl list-units --all --no-legend --plain "${PREFIX}-*.service" 2>/dev/null | awk '{print $1}' | grep '\.service$' | grep -v "${PREFIX}-reload@"
    ls -1 ${SYSTEM_DIR}/${PREFIX}-*.service 2>/dev/null | xargs -n1 basename 2>/dev/null | grep -v "${PREFIX}-reload@"
    local legacy_list=$(grep -l "fire-managed Python Service" /etc/systemd/system/*.service 2>/dev/null)
    [[ -n "$legacy_list" ]] && echo "$legacy_list" | xargs -n1 basename | grep -v "${PREFIX}-reload@"
  } | sort -u
}

get_dashboard_snapshot() {
  local total=0
  local online=0
  local failed=0
  local total_mem_kb=0
  local units=$(get_fire_units)

  for svc in $units; do
    [[ -z "$svc" ]] && continue
    ((total++))

    local props=$(systemctl show --property=ActiveState,MainPID -- "$svc" 2>/dev/null)
    local state=$(echo "$props" | grep ActiveState | cut -d= -f2)
    local pid_val=$(echo "$props" | grep MainPID | cut -d= -f2)

    if [[ "$state" == "active" ]]; then
      ((online++))
      if [[ "$pid_val" =~ ^[0-9]+$ && "$pid_val" -gt 0 ]]; then
        local rss=$(ps -p "$pid_val" -o rss= 2>/dev/null | awk '{print $1}')
        [[ "$rss" =~ ^[0-9]+$ ]] && total_mem_kb=$((total_mem_kb + rss))
      fi
    elif [[ "$state" == "failed" ]]; then
      ((failed++))
    fi
  done

  local total_mem_mb=$(format_mem_kb "$total_mem_kb")
  printf "%s|%s|%s|%s\n" "$total" "$online" "$failed" "$total_mem_mb"
}

