# ================== COMMAND PARSING ==================
CMD="$1"
shift
ARGS=()
NAME_OPT=""
INTERPRETER_OPT=""
ENV_VARS=()
PASSTHROUGH_ARGS=()
JSON_OPT=0

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        NAME_OPT="$2"
        shift 2
        ;;
      --interpreter)
        INTERPRETER_OPT="$2"
        shift 2
        ;;
      --env)
        ENV_VARS+=("$2")
        shift 2
        ;;
      --json)
        JSON_OPT=1
        shift
        ;;
      --)
        shift
        PASSTHROUGH_ARGS+=("$@")
        break
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

# ================== ACTIONS ==================

action_start() {
  local file="${ARGS[0]}"
  [[ -z "$file" ]] && error "No script specified." && exit 1
  [[ ! -f "$file" ]] && error "File not found: $file" && exit 1

  # Determine Name
  local base_name=$(basename "$file")
  local raw_name="${NAME_OPT:-$base_name}"
  local safe_name=$(get_safe_name "$raw_name")
  local service_name="${PREFIX}-${safe_name}.service"
  local service_file="${SYSTEM_DIR}/${service_name}"

  # Determine Interpreter / Executable
  local exec_cmd=""
  local ext="${file##*.}"

  if [[ -n "$INTERPRETER_OPT" ]]; then
    exec_cmd="$INTERPRETER_OPT"
  elif [[ "$ext" == "py" ]]; then
    if [[ -f "$VENV/bin/python" ]]; then
      exec_cmd="$VENV/bin/python"
    else
      exec_cmd="python3"
    fi
  elif [[ "$ext" == "js" ]]; then
    exec_cmd="node"
  elif [[ "$ext" == "sh" ]]; then
    exec_cmd="bash"
  elif [[ -x "$file" ]]; then
    exec_cmd=""
  else
    # Fallback to python if unsure? Or error? Let's default to python for legacy comp
    exec_cmd="python3"
  fi

  # Construct Command
  local resolved_file=""
  if [[ "$file" == /* ]]; then
    resolved_file="$file"
  else
    resolved_file="$WORKDIR/$file"
  fi

  local full_exec=""
  if [[ -n "$exec_cmd" ]]; then
    full_exec="$exec_cmd $resolved_file"
  else
    full_exec="$resolved_file"
  fi

  # Append Passthrough Args
  for a in "${PASSTHROUGH_ARGS[@]}"; do
    full_exec+=" \"$a\""
  done

  # Build Environment Section
  local env_section=""
  for e in "${ENV_VARS[@]}"; do
    env_section+="Environment=\"$e\""$'\n'
  done
  
  # Inject Path for VENV if detected
  if [[ "$full_exec" == *"$VENV"* ]]; then
    env_section+="Environment=\"PATH=$VENV/bin:/usr/local/bin:/usr/bin:/bin\""$'\n'
  fi

  # Check update or create
  if [[ -f "$service_file" ]]; then
    warn "Updating existing service: $safe_name"
    systemctl stop "$service_name"
  fi

  # Write Service File
  cat <<EOF > "$service_file"
[Unit]
Description=Fire Service: $raw_name
After=network.target
StartLimitBurst=15
StartLimitIntervalSec=30m

[Service]
Type=simple
User=$RUN_USER
WorkingDirectory=$WORKDIR
$env_section
ExecStart=$full_exec
Restart=always
RestartSec=3
RestartMaxDelaySec=2m
RestartSteps=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${PREFIX}-${safe_name}

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable "$service_name" >/dev/null
  systemctl start "$service_name"
  
  success "Process started"
  echo -e "   ${BOLD}Name:${NC} $safe_name"
  echo -e "   ${BOLD}Cmd:${NC}  $full_exec"
  echo -e "   ${BOLD}Mode:${NC} $RUN_USER"
}

# ================== TABLE DRAWING FUNCTIONS (Dynamically Defined) ==================
# These functions will be generated inside action_list or action_monit to use dynamic widths

action_list() {
  local TERM_COLS=$(tput cols 2>/dev/null || echo 80)

  declare -A PID_PORTS
  if command -v ss &>/dev/null; then
    local ss_state ss_recv ss_send ss_local ss_peer ss_proc ss_temp ss_pid
    while read -r ss_state ss_recv ss_send ss_local ss_peer ss_proc; do
      [[ "$ss_state" == "State" ]] && continue
      local port_num="${ss_local##*:}"
      ss_temp="$ss_proc"
      while [[ "$ss_temp" =~ pid=([0-9]+) ]]; do
        ss_pid="${BASH_REMATCH[1]}"
        if [[ -n "${PID_PORTS[$ss_pid]}" ]]; then
          if [[ ! ",${PID_PORTS[$ss_pid]}," == *",$port_num,"* ]]; then
            PID_PORTS[$ss_pid]+=",$port_num"
          fi
        else
          PID_PORTS[$ss_pid]="$port_num"
        fi
        ss_temp="${ss_temp#*pid=$ss_pid}"
      done
    done < <(ss -lntp 2>/dev/null)
  fi

  # Column settings (width + priority)
  local ID_W=3
  local STATUS_W=10
  local UPTIME_W=9
  local REST_W=6
  local MEM_W=8
  local CPU_W=7
  local PID_W=7
  
  if [[ $MONIT_MODE -eq 1 ]]; then
    MEM_W=16
    CPU_W=15
  fi

  local APP_NAME_MIN=20
  local APP_NAME_W=$APP_NAME_MIN

  # Which columns to show (ID, NAME, STATUS are essential)
  local show_uptime=1
  local show_rest=1
  local show_mem=1
  local show_cpu=1
  local show_pid=1

  # Total width calculation helper
  get_total_width() {
    local w=$(( ID_W + APP_NAME_W + STATUS_W + 3*3 )) # Always ID, NAME, STATUS + 3 bars
    [[ $show_uptime -eq 1 ]] && w=$(( w + UPTIME_W + 3 ))
    [[ $show_rest -eq 1 ]]   && w=$(( w + REST_W + 3 ))
    [[ $show_mem -eq 1 ]]    && w=$(( w + MEM_W + 3 ))
    [[ $show_cpu -eq 1 ]]    && w=$(( w + CPU_W + 3 ))
    [[ $show_pid -eq 1 ]]    && w=$(( w + PID_W + 3 ))
    echo $w
  }

  # Progressive hiding based on width
  [[ $(get_total_width) -gt $TERM_COLS ]] && show_pid=0
  [[ $(get_total_width) -gt $TERM_COLS ]] && show_cpu=0
  [[ $(get_total_width) -gt $TERM_COLS ]] && show_mem=0
  [[ $(get_total_width) -gt $TERM_COLS ]] && show_rest=0
  [[ $(get_total_width) -gt $TERM_COLS ]] && show_uptime=0

  # Recalculate App Name Width (use remaining space)
  local current_w=$(get_total_width)
  local remaining=$(( TERM_COLS - current_w ))
  [[ $remaining -gt 0 ]] && APP_NAME_W=$(( APP_NAME_MIN + remaining ))

  # --- Dynamic Border Functions ---
  draw_line_part() { local char="$1"; local w="$2"; printf "%s%*s" "$char" "$((w+2))" '' | tr ' ' '─'; }
  draw_line() {
    local line="${GREY}"
    line+=$(draw_line_part "┌" $ID_W)
    line+=$(draw_line_part "┬" $APP_NAME_W)
    line+=$(draw_line_part "┬" $STATUS_W)
    [[ $show_uptime -eq 1 ]] && line+=$(draw_line_part "┬" $UPTIME_W)
    [[ $show_rest -eq 1 ]]   && line+=$(draw_line_part "┬" $REST_W)
    [[ $show_mem -eq 1 ]]    && line+=$(draw_line_part "┬" $MEM_W)
    [[ $show_cpu -eq 1 ]]    && line+=$(draw_line_part "┬" $CPU_W)
    [[ $show_pid -eq 1 ]]    && line+=$(draw_line_part "┬" $PID_W)
    echo -e "${line}┐${NC}"
  }
  draw_sep() {
    local line="${GREY}"
    line+=$(draw_line_part "├" $ID_W)
    line+=$(draw_line_part "┼" $APP_NAME_W)
    line+=$(draw_line_part "┼" $STATUS_W)
    [[ $show_uptime -eq 1 ]] && line+=$(draw_line_part "┼" $UPTIME_W)
    [[ $show_rest -eq 1 ]]   && line+=$(draw_line_part "┼" $REST_W)
    [[ $show_mem -eq 1 ]]    && line+=$(draw_line_part "┼" $MEM_W)
    [[ $show_cpu -eq 1 ]]    && line+=$(draw_line_part "┼" $CPU_W)
    [[ $show_pid -eq 1 ]]    && line+=$(draw_line_part "┼" $PID_W)
    echo -e "${line}┤${NC}"
  }
  draw_bottom() {
    local line="${GREY}"
    line+=$(draw_line_part "└" $ID_W)
    line+=$(draw_line_part "┴" $APP_NAME_W)
    line+=$(draw_line_part "┴" $STATUS_W)
    [[ $show_uptime -eq 1 ]] && line+=$(draw_line_part "┴" $UPTIME_W)
    [[ $show_rest -eq 1 ]]   && line+=$(draw_line_part "┴" $REST_W)
    [[ $show_mem -eq 1 ]]    && line+=$(draw_line_part "┴" $MEM_W)
    [[ $show_cpu -eq 1 ]]    && line+=$(draw_line_part "┴" $CPU_W)
    [[ $show_pid -eq 1 ]]    && line+=$(draw_line_part "┴" $PID_W)
    echo -e "${line}┘${NC}"
  }

  local units=$(get_fire_units)

  if [[ -z "$units" ]]; then
    if [[ $JSON_OPT -eq 1 ]]; then
      echo '{"total_process":0,"active_process":0,"inactive_process":0}'
      return
    fi
    echo -e "\n${YELLOW}No processes managed by fire.${NC}\n"
    return
  fi

  # Collect path units that exist on disk for reload status
  local path_units_str=""
  declare -A SVC_PATH_STATE
  for svc in $units; do
    local path_unit="${svc%.service}.path"
    if [[ -f "${SYSTEM_DIR}/${path_unit}" ]]; then
      path_units_str+=" $path_unit"
    fi
  done

  # Query systemctl in bulk (services + path units in one call)
  declare -A SVC_STATE SVC_PID SVC_RESTARTS SVC_START_TS SVC_STOP_TS SVC_RESTART_POLICY SVC_MEMMAX SVC_CPUQUOTA
  local show_line cur_svc active_state main_pid n_restarts active_enter inactive_enter restart_policy mem_max cpu_quota
  while read -r show_line; do
    if [[ -z "$show_line" ]]; then
      if [[ -n "$cur_svc" ]]; then
        if [[ "$cur_svc" == *.path ]]; then
          SVC_PATH_STATE[$cur_svc]="$active_state"
        else
          SVC_STATE[$cur_svc]="$active_state"
          SVC_PID[$cur_svc]="$main_pid"
          SVC_RESTARTS[$cur_svc]="$n_restarts"
          SVC_START_TS[$cur_svc]="$active_enter"
          SVC_STOP_TS[$cur_svc]="$inactive_enter"
          SVC_RESTART_POLICY[$cur_svc]="$restart_policy"
          SVC_MEMMAX[$cur_svc]="$mem_max"
          SVC_CPUQUOTA[$cur_svc]="$cpu_quota"
        fi
      fi
      cur_svc="" active_state="" main_pid="" n_restarts="" active_enter="" inactive_enter="" restart_policy="" mem_max="" cpu_quota=""
    elif [[ "$show_line" =~ ^Id=(.*)$ ]]; then
      cur_svc="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^ActiveState=(.*)$ ]]; then
      active_state="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^MainPID=(.*)$ ]]; then
      main_pid="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^NRestarts=(.*)$ ]]; then
      n_restarts="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^ActiveEnterTimestamp=(.*)$ ]]; then
      active_enter="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^InactiveEnterTimestamp=(.*)$ ]]; then
      inactive_enter="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^Restart=(.*)$ ]]; then
      restart_policy="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^MemoryMax=(.*)$ ]]; then
      mem_max="${BASH_REMATCH[1]}"
    elif [[ "$show_line" =~ ^CPUQuotaPerSecUSec=(.*)$ ]]; then
      cpu_quota="${BASH_REMATCH[1]}"
    fi
  done < <(systemctl show $units $path_units_str --property=Id,ActiveState,MainPID,NRestarts,ActiveEnterTimestamp,InactiveEnterTimestamp,Restart,MemoryMax,CPUQuotaPerSecUSec 2>/dev/null; echo "")

  # Collect active PIDs and query ps in bulk
  local active_pids=()
  for svc in $units; do
    local state="${SVC_STATE[$svc]}"
    local pid_val="${SVC_PID[$svc]}"
    if [[ "$state" == "active" && "$pid_val" -gt 0 && "$pid_val" != "0" ]]; then
      active_pids+=("$pid_val")
    fi
  done

  declare -A PID_CPU PID_MEM
  if [[ ${#active_pids[@]} -gt 0 ]]; then
    local ps_line ps_pid ps_cpu ps_rss
    local pid_csv=$(IFS=,; echo "${active_pids[*]}")
    while read -r ps_line; do
      read -r ps_pid ps_cpu ps_rss <<< "$ps_line"
      if [[ -n "$ps_pid" && "$ps_pid" =~ ^[0-9]+$ ]]; then
        PID_CPU[$ps_pid]="$ps_cpu"
        PID_MEM[$ps_pid]="$ps_rss"
      fi
    done < <(ps -p "$pid_csv" -o pid=,%cpu=,rss= 2>/dev/null)
  fi

  local row_data=()
  local total_mem_kb=0
  local online_count=0
  local total_count=0

  for svc in $units; do
    [[ -z "$svc" ]] && continue
    ((total_count++))
    local name="$svc"
    local is_legacy=0
    if [[ "$svc" == "${PREFIX}-"* ]]; then
      name=${name#"$PREFIX-"}
      name=${name%.service}
    else
      name="${svc%.service}"
      is_legacy=1
    fi

    local state="${SVC_STATE[$svc]}"
    local pid_val="${SVC_PID[$svc]}"
    local restarts="${SVC_RESTARTS[$svc]}"
    local start_ts="${SVC_START_TS[$svc]}"
    local stop_ts="${SVC_STOP_TS[$svc]}"
    
    local uptime="-"
    local status_icon="○"
    local status_text="stopped"
    local status_color=$RED
    local priority=3

    if [[ "$state" == "active" ]]; then
      uptime=$(format_uptime "$start_ts")
      status_icon="●"
      status_text="online"
      status_color=$GREEN
      priority=1
      ((online_count++))
    elif [[ "$state" == "failed" ]]; then
      status_icon="✖"
      status_text="errored"
      status_color=$RED
      priority=2
    fi
    
    local mem="0.0MB"
    local cpu="0.0%"
    local cpu_num=0
    local mem_num=0
    local port="-"
    if [[ "$state" == "active" && "$pid_val" -gt 0 && "$pid_val" != "0" ]]; then
       local m="${PID_MEM[$pid_val]:-0}"
       local c="${PID_CPU[$pid_val]:-0.0}"
       total_mem_kb=$((total_mem_kb + m))
       mem=$(format_mem_kb "$m")
       cpu="${c}%"
       cpu_num=$(printf "%.0f" "$c")
       mem_num=$m
       port="${PID_PORTS[$pid_val]:--}"
    else
       pid_val="-"
    fi

    local watch="${SVC_RESTART_POLICY[$svc]:-no}"

    local reload_status="off"
    local path_unit="${svc%.service}.path"
    local path_state="${SVC_PATH_STATE[$path_unit]}"
    if [[ -n "$path_state" ]]; then
      [[ "$path_state" == "active" ]] && reload_status="active" || reload_status="ready"
    elif [[ -f "${SYSTEM_DIR}/${path_unit}" ]]; then
      reload_status="ready"
    fi

    local mem_max_raw="${SVC_MEMMAX[$svc]:-infinity}"
    local mem_lim_val="-"
    if [[ "$mem_max_raw" != "infinity" && "$mem_max_raw" != "[not set]" && "$mem_max_raw" =~ ^[0-9]+$ ]]; then
      mem_lim_val="$((mem_max_raw / 1048576))M"
    fi

    local cpu_quota_raw="${SVC_CPUQUOTA[$svc]:-infinity}"
    local cpu_lim_val="-"
    if [[ "$cpu_quota_raw" != "infinity" && "$cpu_quota_raw" != "[not set]" ]]; then
      if [[ "$cpu_quota_raw" =~ ^([0-9]+)us$ ]]; then
        cpu_lim_val="$((${BASH_REMATCH[1]} / 10000))%"
      elif [[ "$cpu_quota_raw" =~ ^([0-9]+)ms$ ]]; then
        cpu_lim_val="$((${BASH_REMATCH[1]} / 10))%"
      fi
    fi

    [[ $is_legacy -eq 1 ]] && name="L:$name"
    row_data+=("$priority|$name|$status_icon|$status_text|$status_color|$uptime|$restarts|$mem|$cpu|$pid_val|$port|$watch|$reload_status|$mem_lim_val|$cpu_lim_val")
  done

  local sorted_rows=$(printf "%s\n" "${row_data[@]}" | sort -t'|' -k1,1n -k2,2)

  if [[ $JSON_OPT -eq 1 ]]; then
    local json_procs=()
    local id=0
    while IFS='|' read -r prio name icon st_text st_color upt rest m_val c_val p_val port_val watch_val reload_val mem_lim_val cpu_lim_val; do
      local pid_num="null"
      if [[ "$p_val" =~ ^[0-9]+$ ]]; then
        pid_num="$p_val"
      fi
      local restarts_num="0"
      if [[ "$rest" =~ ^[0-9]+$ ]]; then
        restarts_num="$rest"
      fi
      json_procs+=("{\"id\":$id,\"name\":\"$name\",\"status\":\"$st_text\",\"uptime\":\"$upt\",\"restarts\":$restarts_num,\"mem\":\"$m_val\",\"cpu\":\"$c_val\",\"pid\":$pid_num,\"port\":\"$port_val\",\"watch\":\"$watch_val\",\"reload\":\"$reload_val\",\"mem_limit\":\"$mem_lim_val\",\"cpu_limit\":\"$cpu_lim_val\"}")
      ((id++))
    done <<< "$sorted_rows"

    local old_ifs="$IFS"
    IFS=","
    local procs_json="${json_procs[*]}"
    IFS="$old_ifs"

    local inactive_count=$((total_count - online_count))
    echo "{\"processes\":[$procs_json],\"total_process\":$total_count,\"active_process\":$online_count,\"inactive_process\":$inactive_count}"
    return
  fi

  echo ""
  draw_line
  local h_fmt="${GREY}│${NC} ${BOLD}%-${ID_W}s${NC} ${GREY}│${NC} ${BOLD}%-${APP_NAME_W}s${NC} ${GREY}│${NC} ${BOLD}%-${STATUS_W}s${NC}"
  local h_args=("ID" "App Name" "Status")
  [[ $show_uptime -eq 1 ]] && h_fmt+=" ${GREY}│${NC} ${BOLD}%-${UPTIME_W}s${NC}" && h_args+=("Uptime")
  [[ $show_rest -eq 1 ]]   && h_fmt+=" ${GREY}│${NC} ${BOLD}%-${REST_W}s${NC}"   && h_args+=("Rest")
  [[ $show_mem -eq 1 ]]    && h_fmt+=" ${GREY}│${NC} ${BOLD}%-${MEM_W}s${NC}"    && h_args+=("Mem")
  [[ $show_cpu -eq 1 ]]    && h_fmt+=" ${GREY}│${NC} ${BOLD}%-${CPU_W}s${NC}"    && h_args+=("CPU")
  [[ $show_pid -eq 1 ]]    && h_fmt+=" ${GREY}│${NC} ${BOLD}%-${PID_W}s${NC}"    && h_args+=("PID")
  h_fmt+=" ${GREY}│${NC}"
  printf "$h_fmt\n" "${h_args[@]}"
  draw_sep

  local id=0
  while IFS='|' read -r prio name icon st_text st_color upt rest m_val c_val p_val port_val watch_val reload_val mem_lim_val cpu_lim_val; do
    local disp_name="$name"
    [[ ${#disp_name} -gt $APP_NAME_W ]] && disp_name="${disp_name:0:$((APP_NAME_W-3))}..."

    printf "${GREY}│${NC} %-${ID_W}d ${GREY}│${NC} %-${APP_NAME_W}s ${GREY}│${NC} ${st_color}%s %-$((STATUS_W-2))s${NC}" "$id" "$disp_name" "$icon" "$st_text"
    [[ $show_uptime -eq 1 ]] && printf " ${GREY}│${NC} %-${UPTIME_W}s" "$upt"
    [[ $show_rest -eq 1 ]]   && printf " ${GREY}│${NC} %-${REST_W}s" "$rest"
    [[ $show_mem -eq 1 ]]    && printf " ${GREY}│${NC} %-${MEM_W}s" "$m_val"
    [[ $show_cpu -eq 1 ]]    && printf " ${GREY}│${NC} %-${CPU_W}s" "$c_val"
    [[ $show_pid -eq 1 ]]    && printf " ${GREY}│${NC} %-${PID_W}s" "$p_val"
    printf " ${GREY}│${NC}\n"
    ((id++))
  done <<< "$sorted_rows"

  draw_bottom
  local total_mem_mb=$(format_mem_kb "$total_mem_kb")
  echo -e " ${YELLOW}${BOLD}Total:${NC} ${YELLOW}${BOLD}$total_count${NC}  ${GREEN}${BOLD}Online:${NC} ${GREEN}${BOLD}$online_count${NC}  ${CYAN}${BOLD}Memory:${NC} ${CYAN}${BOLD}$total_mem_mb${NC}"
  if [[ "${DASHBOARD_MODE:-0}" -ne 1 ]]; then
    echo ""
  fi
}

action_migrate() {
  info "Scanning for legacy services..."
  local legacy_files=$(grep -l "fire-managed Python Service" /etc/systemd/system/*.service 2>/dev/null)
  
  if [[ -z "$legacy_files" ]]; then
    success "No legacy services found."
    return
  fi

  for file in $legacy_files; do
    local old_svc=$(basename "$file")
    local old_name="${old_svc%.service}"
    local new_name="${PREFIX}-${old_name}.service"
    
    warn "Migrating $old_name -> $new_name"
    
    # Extract WorkingDir and ExecStart
    local wd=$(grep "WorkingDirectory=" "$file" | cut -d= -f2)
    local exec=$(grep "ExecStart=" "$file" | cut -d= -f2)
    
    # Extract description name
    local desc=$(grep "Description=" "$file" | sed 's/Description=fire-managed Python Service - //')

    # Stop old using full path to bypass naming issues
    systemctl stop "$file" 2>/dev/null
    systemctl disable "$file" 2>/dev/null
    
    # Move to new name (we'll just rewrite it to ensure new format)
    # new_name will be something like fire-@ccwalletrobot.service
    # We should probably clean the name even more for the new version
    local clean_new_name=$(get_safe_name "$old_name")
    local final_svc_name="${PREFIX}-${clean_new_name}.service"

    cp "$file" "$SYSTEM_DIR/$final_svc_name"
    sed -i "s/Description=fire-managed Python Service - .*/Description=Fire Service: $desc/" "$SYSTEM_DIR/$final_svc_name"
    sed -i "/\[Service\]/a SyslogIdentifier=${PREFIX}-${clean_new_name}" "$SYSTEM_DIR/$final_svc_name"
    
    rm "$file"
    
    systemctl daemon-reload
    systemctl enable "$final_svc_name" >/dev/null
    systemctl start "$final_svc_name"
    success "Migrated $old_name -> $clean_new_name"
  done
}

