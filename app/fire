print_dashboard_banner() {
  print_dashboard_logo "${1:-hot}"
  echo -e "${NC}  ${CYAN}${BOLD}Fire Process Manager${NC} — Interactive Mode"
}

print_dashboard_snapshot_line() {
  local snapshot
  local total=0
  local online=0
  local failed=0
  local memory="0.0MB"

  snapshot=$(get_dashboard_snapshot)
  IFS='|' read -r total online failed memory <<< "$snapshot"
  echo -e "  ${ORANGE}${BOLD}${total}${NC} ${ORANGE}services${NC}  ${GREEN}${BOLD}${online}${NC} ${GREEN}online${NC}  ${RED}${BOLD}${failed}${NC} ${RED}failed${NC}  ${CYAN}${BOLD}${memory}${NC} ${CYAN}RAM${NC}"
}

print_dashboard_tunnel_line() {
  local active=0
  local pending=0
  local active_ports=""
  local pending_ports=""
  local file=""

  ensure_tunnel_dir
  shopt -s nullglob
  local state_files=("$TUNNEL_DIR"/*.env)
  shopt -u nullglob

  for file in "${state_files[@]}"; do
    local port
    port=$(basename "$file" .env)

    load_active_tunnel_state "$port" || continue
    if [[ -n "$TUNNEL_STATE_URL" ]]; then
      ((active++))
      active_ports+="${TUNNEL_STATE_PORT}, "
    else
      ((pending++))
      pending_ports+="${TUNNEL_STATE_PORT}, "
    fi
  done

  active_ports="${active_ports%, }"
  pending_ports="${pending_ports%, }"

  if (( active == 0 && pending == 0 )); then
    echo -e "  ${YELLOW}${BOLD}Tunnels:${NC} ${GREY}none active${NC}"
    return
  fi

  echo -ne "  ${YELLOW}${BOLD}Tunnels:${NC} ${GREEN}${BOLD}${active}${NC} ${GREEN}active${NC}  ${ORANGE}${BOLD}${pending}${NC} ${ORANGE}pending${NC}"
  if [[ -n "$active_ports" ]]; then
    echo -ne "  ${CYAN}${BOLD}Ports:${NC} ${CYAN}${active_ports}${NC}"
  fi
  if [[ -n "$pending_ports" ]]; then
    echo -ne "  ${GREY}${BOLD}Starting:${NC} ${GREY}${pending_ports}${NC}"
  fi
  echo ""
}

