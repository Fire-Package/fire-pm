generate_bash_completion() {
  cat << 'EOF'
# Fire PM Bash Completion
_fire_completions() {
  local cur prev words cword
  _init_completion || return

  local commands="start create list ls status stop restart delete del rm info show live doctor logs log flush clean-logs limit monit migrate update upgrade startup enable-boot unstartup disable-boot save dump restore resurrect tunnel completion help"
  local tunnel_subcmds="open start close stop list setup config"
  local start_flags="--name --env --env-file --no-startup --no-boot --interpreter --user --json"

  _fire_services() {
    local sfiles=(/etc/systemd/system/fire-*.service)
    if [[ -e "${sfiles[0]}" ]]; then
      for f in "${sfiles[@]}"; do
        local b=$(basename "$f")
        [[ "$b" == *"-reload@.service" || "$b" == "*.bak" || "$b" == "*~" ]] && continue
        local name="${b#fire-}"
        name="${name%.service}"
        echo "$name"
      done
    fi
  }

  case "$cword" in
    1)
      COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
      return 0
      ;;
    2)
      case "${words[1]}" in
        stop|restart|delete|del|rm|info|show|live|logs|log|flush|clean-logs|startup|enable-boot|unstartup|disable-boot|limit)
          local svcs
          svcs=$(_fire_services)
          if [[ "${words[1]}" =~ ^(stop|restart|logs|log|flush|clean-logs|startup|enable-boot|unstartup|disable-boot)$ ]]; then
            svcs="$svcs all"
          fi
          COMPREPLY=( $(compgen -W "$svcs" -- "$cur") )
          return 0
          ;;
        tunnel)
          COMPREPLY=( $(compgen -W "$tunnel_subcmds" -- "$cur") )
          return 0
          ;;
        completion)
          COMPREPLY=( $(compgen -W "bash zsh fish install" -- "$cur") )
          return 0
          ;;
        start|create)
          if [[ "$cur" == -* ]]; then
            COMPREPLY=( $(compgen -W "$start_flags" -- "$cur") )
          else
            _filedir
          fi
          return 0
          ;;
        save|dump|restore|resurrect)
          _filedir
          return 0
          ;;
      esac
      ;;
    *)
      case "${words[1]}" in
        start|create)
          case "$prev" in
            --env-file)
              _filedir
              return 0
              ;;
            --interpreter)
              COMPREPLY=( $(compgen -W "python3 python node bash sh bun deno" -- "$cur") )
              return 0
              ;;
            *)
              if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$start_flags" -- "$cur") )
                return 0
              fi
              ;;
          esac
          ;;
        tunnel)
          if [[ "${words[2]}" == "open" && "$cur" == -* ]]; then
            COMPREPLY=( $(compgen -W "--provider --quick --custom" -- "$cur") )
            return 0
          fi
          if [[ "$prev" == "--provider" ]]; then
            COMPREPLY=( $(compgen -W "quick custom" -- "$cur") )
            return 0
          fi
          ;;
      esac
      ;;
  esac
}
complete -F _fire_completions fire
EOF
}

