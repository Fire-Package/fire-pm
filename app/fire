action_completion() {
  local target="${ARGS[0]}"

  case "$target" in
    bash)
      generate_bash_completion
      ;;
    zsh)
      generate_zsh_completion
      ;;
    fish)
      generate_fish_completion
      ;;
    install|--install)
      if [[ -d "/etc/bash_completion.d" ]]; then
        generate_bash_completion > /etc/bash_completion.d/fire 2>/dev/null || sudo bash -c "fire completion bash > /etc/bash_completion.d/fire"
        chmod 644 /etc/bash_completion.d/fire 2>/dev/null || true
        success "Bash completion installed to /etc/bash_completion.d/fire"
      elif [[ -d "/usr/share/bash-completion/completions" ]]; then
        generate_bash_completion > /usr/share/bash-completion/completions/fire 2>/dev/null || sudo bash -c "fire completion bash > /usr/share/bash-completion/completions/fire"
        success "Bash completion installed to /usr/share/bash-completion/completions/fire"
      else
        mkdir -p "$HOME/.bash_completion.d"
        generate_bash_completion > "$HOME/.bash_completion.d/fire"
        grep -q "source.*\.bash_completion\.d/fire" "$HOME/.bashrc" 2>/dev/null || echo "[[ -f ~/.bash_completion.d/fire ]] && source ~/.bash_completion.d/fire" >> "$HOME/.bashrc"
        success "Bash completion installed to ~/.bash_completion.d/fire and added to ~/.bashrc"
      fi
      ;;
    *)
      info "Fire PM Shell Auto-Completion"
      echo ""
      echo "  To enable auto-completion for your shell:"
      echo ""
      echo "  Bash (auto-install):"
      echo -e "    ${CYAN}fire completion install${NC}"
      echo ""
      echo "  Bash (manual):"
      echo -e "    ${CYAN}source <(fire completion bash)${NC}"
      echo ""
      echo "  Zsh:"
      echo -e "    ${CYAN}fire completion zsh > ~/.zsh/completion/_fire${NC}"
      echo ""
      echo "  Fish:"
      echo -e "    ${CYAN}fire completion fish > ~/.config/fish/completions/fire.fish${NC}"
      echo ""
      ;;
  esac
}

show_help() {
  echo "Usage: fire <command> [options]"
  echo ""
  echo "Commands:"
  echo "  start <script>   Start a script (py, js, sh) as a service"
  echo "    --name <name>    Set a custom name"
  echo "    --env KEY=VAL    Set environment variable (repeatable)"
  echo "    --env-file <path> Load environment variables from a .env file"
  echo "    -- <args>        Pass arguments to the script"
  echo "  list             List all managed processes"
  echo "  status [--json]  Show status summary in JSON format"
  echo "  stop <name|all>  Stop a process"
  echo "  restart <name>   Restart a process"
  echo "  delete <name|--stopped> Delete a process or all stopped processes"
  echo "  info <name|file> Show detailed information about a process"
  echo "  show <name|file> Alias for info"
  echo "  live <name>      Open live cockpit for a process"
  echo "  doctor           Run system health diagnostics"
  echo "  logs [name]      Stream logs"
  echo "  flush [name|all] Flush accumulated service logs and journal"
  echo "  monit            Real-time monitoring dashboard"
  echo "  migrate          Migrate legacy fire services to new format"
  echo "  update           Update Fire PM to the latest version"
  echo "  startup <name|all> Enable service auto-start on system boot"
  echo "  unstartup <name|all> Disable service auto-start on system boot"
  echo "  save [path]      Save running process snapshot to dump.json (alias: dump)"
  echo "  restore [path]   Restore all processes from dump.json (alias: resurrect)"
  echo "  completion [sh]  Generate or install shell auto-completion (bash, zsh, fish)"
  echo "  tunnel open <port>  Open a public HTTPS tunnel"
  echo "  tunnel list         List active tunnels"
  echo "  tunnel close <port> Close a tunnel"
  echo "  tunnel setup        Configure custom domain tunnels"
  echo ""
  echo "Examples:"
  echo "  fire start server.py --name api"
  echo "  fire start app.js --env-file .env --env NODE_ENV=production"
  echo "  fire tunnel open 3000"
  echo "  fire update"
}

# ================== ROUTING ==================
ORIG_CLI_ARGS=("$CMD" "$@")
TUNNEL_CMD=""
if [[ "$CMD" == "tunnel" ]]; then
  if [[ $# -gt 0 ]]; then
    TUNNEL_CMD="$1"
    shift
  fi
  ARGS=("$@")
else
  # Handle implied start if first arg is a file
  if [[ -f "$CMD" ]]; then
     ARGS+=("$CMD")
     CMD="start"
  fi

  parse_args "$@"
fi

if command_needs_root "$CMD" "$TUNNEL_CMD"; then
  ensure_root "${ORIG_CLI_ARGS[@]}"
fi

case "$CMD" in
  start|create)  action_start ;;
  list|ls|status) action_list ;;
  stop)          action_stop ;;
  restart)       action_restart ;;
  delete|del|rm) action_delete ;;
  info|show)     action_info ;;
  live)          action_live ;;
  doctor)        action_doctor ;;
  logs|log)      action_logs ;;
  flush|clean-logs) action_flush ;;
  limit)         action_limit ;;
  monit)         action_monit ;;
  migrate)       action_migrate ;;
  update|upgrade) action_update ;;
  startup|enable-boot) action_startup ;;
  unstartup|disable-boot) action_unstartup ;;
  save|dump)     action_save ;;
  restore|resurrect) action_restore ;;
  completion|completions) action_completion ;;
  tunnel)        action_tunnel ;;
  help|--help|-h) show_help ;;
  *)
    if [[ -z "$CMD" ]]; then
      action_dashboard
    else
      error "Unknown command: $CMD"
      show_help
    fi
    ;;
esac
