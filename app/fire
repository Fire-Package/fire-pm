action_delete() {
  local delete_stopped=0
  local targets=()
  local deleted_any=0

  for arg in "${ARGS[@]}"; do
    if [[ "$arg" == "--stopped" ]]; then
      delete_stopped=1
    else
      targets+=("$arg")
    fi
  done

  if [[ $delete_stopped -eq 1 ]]; then
    local stopped_units=()
    local units=$(systemctl list-units --all --no-legend --plain "${PREFIX}-*.service" | awk '{print $1}')
    for svc in $units; do
      local state=$(systemctl show --property=ActiveState -- "$svc" | cut -d= -f2)
      if [[ "$state" != "active" ]]; then
        stopped_units+=("$svc")
      fi
    done

    if [[ ${#stopped_units[@]} -gt 0 ]]; then
      echo -n -e "${YELLOW}⚠${NC} ${#stopped_units[@]} stopped processes found. Delete them? (y/n) "
      read -r confirm
      if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        for svc in "${stopped_units[@]}"; do
          local name=${svc#"$PREFIX-"}
          name=${name%.service}
          systemctl stop "$svc" 2>/dev/null
          systemctl disable "$svc" 2>/dev/null
          rm -f "$SYSTEM_DIR/$svc"
          success "Deleted $name"
          deleted_any=1
        done
      else
        info "Aborted batch delete."
      fi
    else
      info "No stopped processes found."
    fi
  fi

  if [[ ${#targets[@]} -gt 0 ]]; then
    for target in "${targets[@]}"; do
      local svc_name=$(resolve_service_name "$target")
      if [[ -n "$svc_name" ]]; then
        local display_name="${svc_name#$PREFIX-}"
        display_name="${display_name%.service}"
        systemctl stop "$svc_name" 2>/dev/null
        systemctl disable "$svc_name" 2>/dev/null
        rm -f "$SYSTEM_DIR/$svc_name"
        success "Deleted $display_name"
        deleted_any=1
      else
        error "Process not found: $target"
      fi
    done
  elif [[ $delete_stopped -eq 0 ]]; then
    error "Usage: fire delete <name|--stopped> [names...]"
    exit 1
  fi

  if [[ $deleted_any -eq 1 ]]; then
    systemctl daemon-reload
  fi
}

action_info() {
  local target="${ARGS[0]}"
  [[ -z "$target" ]] && error "Usage: fire info <name|file>" && exit 1

  local svc_name=$(resolve_service_name "$target")
  if [[ -z "$svc_name" ]]; then
      error "Process not found: $target"
      exit 1
  fi

  local svc_file="${SYSTEM_DIR}/${svc_name}"
  local props=$(systemctl show --property=ActiveState,MainPID,NRestarts,ActiveEnterTimestamp,InactiveEnterTimestamp,ExecStart,WorkingDirectory,User,Description -- "$svc_name")
  
  local state=$(echo "$props" | grep ActiveState | cut -d= -f2)
  local pid=$(echo "$props" | grep MainPID | cut -d= -f2)
  local restarts=$(echo "$props" | grep NRestarts | cut -d= -f2)
  local start_ts=$(echo "$props" | grep ActiveEnterTimestamp | cut -d= -f2)
  local stop_ts=$(echo "$props" | grep InactiveEnterTimestamp | cut -d= -f2)
  local exec_start=$(echo "$props" | grep ExecStart | cut -d= -f2-)
  local work_dir=$(echo "$props" | grep WorkingDirectory | cut -d= -f2-)
  local user=$(echo "$props" | grep User | cut -d= -f2-)
  local raw_name=$(echo "$props" | grep Description | sed 's/Description=Fire Service: //')

  # Parse ExecStart for Interpreter, Script, Args
  # Format of systemctl ExecStart: { path=/... ; argv[]=/... ; ignore_errors=no ; ... }
  # We extract the part inside argv[]
  local argv_str=$(echo "$exec_start" | sed -n 's/.*argv\[\]=\([^;]*\).*/\1/p' | xargs)
  local interpreter=$(echo "$argv_str" | cut -d' ' -f1)
  local script_and_args=$(echo "$argv_str" | cut -d' ' -f2-)
  
  local script=""
  local args=""
  if [[ "$script_and_args" =~ ($work_dir/[^ ]+) ]]; then
      script="${BASH_REMATCH[1]}"
      args="${script_and_args#*"$script"}"
      args="${args#" "}"
  else
      script=$(echo "$script_and_args" | cut -d' ' -f1)
      args=$(echo "$script_and_args" | cut -d' ' -f2-)
  fi

  # Resource Usage
  local mem="0.0MB"
  local cpu="0.0%"
  if [[ "$state" == "active" && "$pid" -gt 0 ]]; then
      local stats=$(ps -p "$pid" -o %cpu=,rss= 2>/dev/null)
      if [[ -n "$stats" ]]; then
          read c m <<< "$stats"
          mem=$(awk "BEGIN {printf \"%.1fMB\", $m/1024}")
          cpu="${c}%"
      fi
  fi

  # Status Styling
  local status_color=$RED
  [[ "$state" == "active" ]] && status_color=$GREEN

  # Uptime / Stopped at
  local time_info="-"
  if [[ "$state" == "active" ]]; then
      time_info=$(format_uptime "$start_ts")
  elif [[ -n "$stop_ts" && "$stop_ts" != "n/a" ]]; then
      time_info=$(TZ='Asia/Kolkata' date -d "$stop_ts" "+%b %d, %H:%M IST" 2>/dev/null)
  fi

  if [[ $JSON_OPT -eq 1 ]]; then
    local pid_num="null"
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]] && pid_num="$pid"
    local restarts_num="0"
    [[ "$restarts" =~ ^[0-9]+$ ]] && restarts_num="$restarts"

    local safe_script=$(echo "$script" | sed 's/\\/\\\\/g; s/"/\\"/g')
    local safe_args=$(echo "${args:-}" | sed 's/\\/\\\\/g; s/"/\\"/g')
    local safe_work_dir=$(echo "$work_dir" | sed 's/\\/\\\\/g; s/"/\\"/g')
    local safe_raw_name=$(echo "$raw_name" | sed 's/\\/\\\\/g; s/"/\\"/g')
    local safe_interpreter=$(echo "$interpreter" | sed 's/\\/\\\\/g; s/"/\\"/g')
    local safe_time_info=$(echo "$time_info" | sed 's/\\/\\\\/g; s/"/\\"/g')

    echo "{\"name\":\"$safe_raw_name\",\"service\":\"$svc_name\",\"status\":\"$state\",\"pid\":$pid_num,\"restarts\":$restarts_num,\"uptime\":\"$([[ "$state" == "active" ]] && echo "$safe_time_info" || echo "-")\",\"stopped_at\":\"$([[ "$state" != "active" ]] && echo "$safe_time_info" || echo "-")\",\"mem\":\"$mem\",\"cpu\":\"$cpu\",\"interpreter\":\"$safe_interpreter\",\"script\":\"$safe_script\",\"args\":\"$safe_args\",\"working_directory\":\"$safe_work_dir\",\"user\":\"$user\",\"log_path\":\"journalctl -u $svc_name -f\"}"
    return
  fi

  echo -e "${BOLD}Describing process with name ${CYAN}$raw_name${NC}"
  echo -e "${GREY}---------------------------------------------------------------------------${NC}"
  printf "  %-17s : ${status_color}%s${NC}\n" "status" "$state"
  printf "  %-17s : %s\n" "name" "$raw_name"
  printf "  %-17s : %s\n" "interpreter" "$interpreter"
  printf "  %-17s : %s\n" "script" "$script"
  printf "  %-17s : %s\n" "args" "${args:-None}"
  printf "  %-17s : %s\n" "working directory" "$work_dir"
  printf "  %-17s : %s\n" "user" "$user"
  printf "  %-17s : %s\n" "pid" "$([[ "$pid" == "0" ]] && echo "-" || echo "$pid")"
  printf "  %-17s : %s\n" "restarts" "$restarts"
  printf "  %-17s : %s\n" "uptime" "$([[ "$state" == "active" ]] && echo "$time_info" || echo "-")"
  printf "  %-17s : %s\n" "stopped at" "$([[ "$state" != "active" ]] && echo "$time_info" || echo "-")"
  printf "  %-17s : %s\n" "mem" "$mem"
  printf "  %-17s : %s\n" "cpu" "$cpu"
  printf "  %-17s : %s\n" "log path" "journalctl -u $svc_name -f"
  echo -e "${GREY}---------------------------------------------------------------------------${NC}"
}

action_live() {
  local target="${ARGS[0]}"
  [[ -z "$target" ]] && error "Usage: fire live <name|file>" && exit 1

  local svc_name=$(resolve_service_name "$target")
  if [[ -z "$svc_name" ]]; then
      error "Process not found: $target"
      exit 1
  fi

  trap "printf '\033[?25h'; return" INT TERM
  printf "\033[?25l" # Hide cursor

  while true; do
    clear
    local props=$(systemctl show --property=ActiveState,MainPID,NRestarts,ActiveEnterTimestamp,Description -- "$svc_name" 2>/dev/null)
    local state=$(echo "$props" | grep ActiveState | cut -d= -f2)
    local pid=$(echo "$props" | grep MainPID | cut -d= -f2)
    local restarts=$(echo "$props" | grep NRestarts | cut -d= -f2)
    local start_ts=$(echo "$props" | grep ActiveEnterTimestamp | cut -d= -f2)
    local raw_name=$(echo "$props" | grep Description | sed 's/Description=Fire Service: //')

    local status_color=$RED
    [[ "$state" == "active" ]] && status_color=$GREEN

    echo -e "${BOLD}Cockpit:${NC} ${CYAN}$raw_name${NC} [${status_color}$state${NC}]"
    echo -e "${GREY}PID: $pid | Uptime: $(format_uptime "$start_ts") | Restarts: $restarts${NC}"
    echo ""

    if [[ "$state" == "active" && "$pid" -gt 0 ]]; then
      local stats=$(ps -p "$pid" -o %cpu=,rss= 2>/dev/null)
      if [[ -n "$stats" ]]; then
        read c m <<< "$stats"
        local cpu_bar=$(printf "%.0f" "$c")
        local mem_mb=$(awk "BEGIN {printf \"%.1fMB\", $m/1024}")
        
        # Draw CPU Bar
        echo -n -e "  CPU: ${BOLD}${c}%${NC} ["
        local filled=$((cpu_bar / 5))
        [[ $filled -gt 20 ]] && filled=20
        for ((i=0; i<filled; i++)); do echo -n "█"; done
        for ((i=filled; i<20; i++)); do echo -n "░"; done
        echo "]"
        
        # Mem info
        echo -e "  MEM: ${BOLD}${mem_mb}${NC}"
      fi
    fi

    echo -e "\n${BOLD}Live Logs:${NC} (last 15 lines)"
    echo -e "${GREY}--------------------------------------------------${NC}"
    journalctl -u "$svc_name" -n 15 --no-pager | sed 's/^.*: //' # Strip timestamp/hostname for cleaner view
    echo -e "${GREY}--------------------------------------------------${NC}"
    echo -e "${GREY}Press [r] Restart, [s] Stop/Start, [q] Quit${NC}"

    read -t 1 -n 1 key
    case "$key" in
      r) systemctl restart "$svc_name"; echo -e "\n${YELLOW}Restarting...${NC}"; sleep 1 ;;
      s) 
        if [[ "$state" == "active" ]]; then
          systemctl stop "$svc_name"
          echo -e "\n${YELLOW}Stopping...${NC}"
        else
          systemctl start "$svc_name"
          echo -e "\n${GREEN}Starting...${NC}"
        fi
        sleep 1 ;;
      q) printf "\033[?25h"; return ;;
    esac
  done
}

