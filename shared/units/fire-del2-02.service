[Unit]
Description=Fire Service: del2-02
After=network.target
StartLimitBurst=15
StartLimitIntervalSec=30m

[Service]
Type=simple
User=root
WorkingDirectory=/root/Bio
Environment="PATH=/root/myenv/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/root/myenv/bin/python /root/Bio/del2.py "8489478524:AAFTdSF1Pzxu8kNYmEDxGOBSIJWjDacyGU0"
Restart=always
RestartSec=3
RestartMaxDelaySec=2m
RestartSteps=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fire-del2-02

[Install]
WantedBy=multi-user.target
